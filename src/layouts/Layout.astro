---
import '../styles/global.css';
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const otherLang = lang === 'de' ? 'en' : 'de';
const base = import.meta.env.BASE_URL;
const homeHref = base;
const enHref = `${base}en/`;
const otherHref = lang === 'de' ? enHref : homeHref;
const selfHref = lang === 'de' ? homeHref : enHref;

const site = 'https://plaintext.ch/';
const canonical = lang === 'de' ? site : `${site}en/`;
const ogImage = `${site}og-image.png`;

// Structured data so search engines understand who we are and what we offer.
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Plaintext GmbH',
  url: site,
  email: 'hello@plaintext.ch',
  foundingDate: '2020',
  vatID: 'CHE-488.786.867',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Neuhusmatte 155',
    postalCode: '3083',
    addressLocality: 'Trimstein',
    addressCountry: 'CH',
  },
  areaServed: 'CH',
  founder: { '@type': 'Person', name: 'Daniel Marthaler' },
  sameAs: ['https://github.com/Plaintext-Gmbh'],
  knowsAbout: [
    'Software architecture',
    'CI/CD automation',
    'Legacy modernisation',
    'AI integration',
    'Model Context Protocol',
  ],
};
---

<!doctype html>
<html lang={s.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={s.meta.description} />
    <meta name="theme-color" content="#2D2BFE" />
    <meta property="og:title" content={s.meta.title} />
    <meta property="og:description" content={s.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}projectmind-icon.svg`} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <link rel="alternate" hreflang={lang} href={selfHref} />
    <link rel="alternate" hreflang={otherLang} href={otherHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <title>{s.meta.title}</title>
  </head>
  <body>
    <slot />

    <script is:inline>
      // Reveal-on-scroll: fade + lift .reveal elements as they enter the viewport.
      // Without IntersectionObserver everything stays visible via .no-js.
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      } else {
        document.documentElement.classList.add('no-js');
      }
    </script>
  </body>
</html>
