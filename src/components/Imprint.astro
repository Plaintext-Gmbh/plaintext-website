---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).imprint;
const homeHref = lang === 'de' ? '/' : '/en/';
---

<main class="pt-32 pb-24 min-h-[60vh]">
  <article class="max-w-3xl mx-auto px-6">
    <a
      href={homeHref}
      class="inline-flex items-center gap-1 text-sm font-mono text-[var(--color-brand-500)] hover:text-[var(--color-brand-700)] transition mb-10"
    >
      {s.backLabel}
    </a>

    <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight mb-10">{s.title}</h1>

    <div class="bg-[var(--color-ink-50)] rounded-xl p-6 md:p-8 mb-12 border border-[var(--color-ink-100)]">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-brand-500)] mb-3">{s.company}</p>
      <address class="not-italic text-[var(--color-ink-900)] leading-relaxed mb-4">
        {s.addressLines.map((line) => (
          <div>{line}</div>
        ))}
      </address>
      <div class="text-sm space-y-1">
        <div>
          <span class="text-[var(--color-ink-500)]">E-Mail: </span>
          <a class="text-[var(--color-brand-500)] hover:text-[var(--color-brand-700)] transition" href={`mailto:${s.email}`}>{s.email}</a>
        </div>
        <div>
          <span class="text-[var(--color-ink-500)]">UID / MWST: </span>
          <span class="font-mono">{s.uid}</span>
        </div>
      </div>
    </div>

    {s.sections.map((section) => (
      <section class="mb-10">
        <h2 class="text-2xl font-bold mb-4 tracking-tight">{section.heading}</h2>
        <div class="space-y-4 text-[var(--color-ink-700)] leading-relaxed">
          {section.body.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </section>
    ))}
  </article>
</main>
