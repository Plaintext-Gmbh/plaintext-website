---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';
import Hero from './Hero.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).imprint;
---

<Hero title={s.title} label={s.company} facts={[...s.addressLines, s.uid]} />

<div class="wrap pb-16 md:pb-28">
  <p class="border-t border-ink-900 pt-5 grid md:grid-cols-12 gap-x-8">
    <span class="label md:col-span-3">E-Mail</span>
    <a class="md:col-span-9 text-brand-500 hover:text-brand-700 underline underline-offset-4" href={`mailto:${s.email}`}>{s.email}</a>
  </p>
  {s.sections.map((section) => (
    <section class="mt-12 border-t border-ink-200 pt-5 grid md:grid-cols-12 gap-x-8 gap-y-4">
      <h2 class="md:col-span-3 text-lg font-medium">{section.heading}</h2>
      <div class="md:col-span-8 space-y-4 text-ink-700 leading-relaxed">
        {section.body.map((p) => <p>{p}</p>)}
      </div>
    </section>
  ))}
</div>
