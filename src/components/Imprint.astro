---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';
import Hero from './Hero.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).imprint;
---

<Hero title={s.title} label={s.company} facts={[...s.addressLines, s.uid]} />

<div class="wrap py-16 md:py-24">
  <div class="max-w-3xl mx-auto">
    <p class="panel flex flex-wrap gap-x-4 gap-y-1">
      <span class="label">E-Mail</span>
      <a class="link-arrow" href={`mailto:${s.email}`}>{s.email}</a>
    </p>
    {s.sections.map((section) => (
      <section class="mt-12">
        <h2 class="text-2xl font-semibold tracking-tight mb-4">{section.heading}</h2>
        <div class="space-y-4 text-ink-700 leading-relaxed">
          {section.body.map((p) => <p>{p}</p>)}
        </div>
      </section>
    ))}
  </div>
</div>
