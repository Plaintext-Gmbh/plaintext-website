---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';
import Hero from './Hero.astro';
import Section from './Section.astro';
import Keywords from './Keywords.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).legacy;
---

<Hero title={s.hero.title} label={s.hero.eyebrow} body={s.hero.body} />

<Section id="situation" label={s.situation.eyebrow} title={s.situation.title} body={s.situation.body}>
  <div class="grid md:grid-cols-3 gap-5">
    {s.situation.items.map(([head, body]) => (
      <div class="panel">
        <h3 class="text-lg font-semibold tracking-tight">{head}</h3>
        <p class="mt-2 text-ink-500 leading-relaxed">{body}</p>
      </div>
    ))}
  </div>
</Section>

<Section id="process" label={s.process.eyebrow} tone="grey" title={s.process.title}>
  <ol class="max-w-3xl mx-auto space-y-4">
    {s.process.steps.map((step, i) => (
      <li class="panel flex gap-5 md:gap-7">
        <span class="label text-brand-500 pt-1" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <div class="min-w-0">
          <h3 class="text-xl font-semibold tracking-tight">{step.title}</h3>
          <p class="mt-2 text-ink-500 leading-relaxed">{step.body}</p>
          <p class="mt-4 text-sm"><span class="label mr-2">{s.process.resultLabel}</span>{step.result}</p>
        </div>
      </li>
    ))}
  </ol>
</Section>

<Section id="deliverables" label={s.deliverables.eyebrow} title={s.deliverables.title}>
  <div class="grid md:grid-cols-3 gap-5">
    {s.deliverables.items.map(([head, body]) => (
      <div class="panel">
        <h3 class="text-lg font-semibold tracking-tight">{head}</h3>
        <p class="mt-2 text-ink-500 leading-relaxed">{body}</p>
      </div>
    ))}
  </div>
</Section>

<Section id="reference" label={s.reference.label} tone="grey">
  <article class="panel grid md:grid-cols-5 gap-x-10 gap-y-3">
    <div class="md:col-span-2">
      <p class="label">{s.reference.kicker}</p>
      <h3 class="mt-2 text-xl font-semibold tracking-tight">{s.reference.title}</h3>
    </div>
    <div class="md:col-span-3">
      <p class="text-ink-500 leading-relaxed">{s.reference.body}</p>
      <Keywords items={s.reference.chips} class="mt-4" />
    </div>
  </article>
</Section>
