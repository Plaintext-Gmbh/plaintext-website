---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';
import Hero from './Hero.astro';
import Section from './Section.astro';
import Keywords from './Keywords.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).legacy;
const row = 'border-t border-ink-200 pt-4 pb-8 grid md:grid-cols-9 gap-x-8 gap-y-2';
---

<Hero title={s.hero.title} label={s.hero.eyebrow} body={s.hero.body} />

<Section id="situation" nr="01" label={s.situation.eyebrow} tone="grey" title={s.situation.title} body={s.situation.body}>
  <dl>
    {s.situation.items.map(([head, body]) => (
      <div class={row}>
        <dt class="md:col-span-3 text-lg font-medium">{head}</dt>
        <dd class="md:col-span-6 text-ink-700 leading-relaxed">{body}</dd>
      </div>
    ))}
  </dl>
</Section>

<Section id="process" nr="02" label={s.process.eyebrow} title={s.process.title}>
  <ol>
    {s.process.steps.map((step, i) => (
      <li class="border-t border-ink-200 pt-4 pb-10 grid md:grid-cols-9 gap-x-8 gap-y-3">
        <p class="md:col-span-3 display text-5xl md:text-6xl text-brand-500" aria-hidden="true">{i + 1}</p>
        <div class="md:col-span-6">
          <h3 class="text-2xl font-medium tracking-tight">{step.title}</h3>
          <p class="mt-3 text-ink-700 leading-relaxed">{step.body}</p>
          <p class="label mt-4"><span class="text-ink-900">{s.process.resultLabel}:</span> {step.result}</p>
        </div>
      </li>
    ))}
  </ol>
</Section>

<Section id="deliverables" nr="03" label={s.deliverables.eyebrow} tone="grey" title={s.deliverables.title}>
  <dl>
    {s.deliverables.items.map(([head, body]) => (
      <div class={row}>
        <dt class="md:col-span-3 text-lg font-medium">{head}</dt>
        <dd class="md:col-span-6 text-ink-700 leading-relaxed">{body}</dd>
      </div>
    ))}
  </dl>
</Section>

<Section id="reference" nr="04" label={s.reference.label} title={s.reference.title}>
  <div class="grid md:grid-cols-9 gap-x-8 gap-y-3">
    <p class="label md:col-span-3">{s.reference.kicker}</p>
    <div class="md:col-span-6">
      <p class="text-lg leading-relaxed">{s.reference.body}</p>
      <Keywords items={s.reference.chips} class="mt-4" />
    </div>
  </div>
</Section>
