---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';
import SectionHeader from './SectionHeader.astro';
import Keywords from './Keywords.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).legacy;
---

<section class="pt-32 pb-16 md:pt-44 md:pb-24">
  <div class="max-w-6xl mx-auto px-5 sm:px-6">
    <div class="max-w-3xl reveal">
      <p class="eyebrow mb-6">{s.hero.eyebrow}</p>
      <h1 class="text-4xl sm:text-5xl md:text-6xl display">{s.hero.title}</h1>
      <p class="mt-7 text-lg md:text-xl text-ink-500 leading-relaxed max-w-2xl">{s.hero.body}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="#contact" class="btn btn-primary">{s.hero.primary}</a>
        <a href="#process" class="btn btn-secondary">{s.hero.secondary}</a>
      </div>
    </div>
    <Keywords items={s.hero.facts} class="mt-14 pt-6 border-t border-ink-200 reveal" />
  </div>
</section>

<section id="situation" class="py-20 md:py-28 bg-ink-50">
  <div class="max-w-6xl mx-auto px-5 sm:px-6">
    <SectionHeader eyebrow={s.situation.eyebrow} title={s.situation.title} body={s.situation.body} />
    <div class="grid md:grid-cols-3 gap-x-10 gap-y-8">
      {s.situation.items.map(([head, body], i) => (
        <div class="reveal border-t border-ink-200 pt-5" style={`transition-delay: ${i * 60}ms;`}>
          <h3 class="text-lg font-semibold tracking-tight">{head}</h3>
          <p class="mt-2 text-ink-500 leading-relaxed">{body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="process" class="py-20 md:py-28">
  <div class="max-w-6xl mx-auto px-5 sm:px-6">
    <SectionHeader eyebrow={s.process.eyebrow} title={s.process.title} body={s.process.body} />
    <ol class="border-t border-ink-200">
      {s.process.steps.map((step, i) => (
        <li class="reveal grid md:grid-cols-12 gap-x-8 gap-y-3 py-8 md:py-10 border-b border-ink-200">
          <span class="md:col-span-1 font-mono text-sm text-brand-500" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="md:col-span-4 text-xl md:text-2xl display">{step.title}</h3>
          <div class="md:col-span-7">
            <p class="text-ink-700 leading-relaxed">{step.body}</p>
            <p class="mt-4 text-sm text-ink-500">
              <span class="font-mono text-xs text-brand-500 mr-2">{s.process.resultLabel}</span>{step.result}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section id="deliverables" class="py-20 md:py-28 bg-ink-50">
  <div class="max-w-6xl mx-auto px-5 sm:px-6">
    <SectionHeader eyebrow={s.deliverables.eyebrow} title={s.deliverables.title} />
    <div class="grid md:grid-cols-3 gap-5">
      {s.deliverables.items.map(([head, body], i) => (
        <article class="card reveal" style={`transition-delay: ${i * 60}ms;`}>
          <h3 class="text-xl font-semibold tracking-tight">{head}</h3>
          <p class="mt-2 text-ink-500 leading-relaxed">{body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="benefits" class="py-20 md:py-28">
  <div class="max-w-6xl mx-auto px-5 sm:px-6">
    <SectionHeader eyebrow={s.benefits.eyebrow} title={s.benefits.title} />
    <div class="grid md:grid-cols-3 gap-x-10 gap-y-8">
      {s.benefits.items.map(([head, body], i) => (
        <div class="reveal border-t border-ink-200 pt-5" style={`transition-delay: ${i * 60}ms;`}>
          <h3 class="text-lg font-semibold tracking-tight">{head}</h3>
          <p class="mt-2 text-ink-500 leading-relaxed">{body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
