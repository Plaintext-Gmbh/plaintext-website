---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).others;
---

<Section id="products" nr="03" label={s.eyebrow} title={s.title} body={s.body}>
  {s.items.map((item) => (
    <article class="border-t border-ink-200 pt-4 grid md:grid-cols-9 gap-x-8 gap-y-3">
      <p class="label md:col-span-3">{item.name}<br />MPL-2.0</p>
      <div class="md:col-span-6">
        <p class="text-ink-700 leading-relaxed">{item.body}</p>
        <p class="mt-5">
          <a href={item.link} target="_blank" rel="noopener" class="link-arrow">{item.linkLabel}</a>
        </p>
      </div>
    </article>
  ))}
</Section>
