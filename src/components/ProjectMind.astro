---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';
import Hero from './Hero.astro';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).pm;
const installCmd = 'curl -fsSL https://raw.githubusercontent.com/Plaintext-Gmbh/projectmind/master/scripts/install.sh | sh';
---

<Hero title={s.title} title2={s.subtitle} label={s.eyebrow} facts={[s.kicker]} body={s.body} />

<Section id="features" nr="01" label={s.featuresLabel}>
  <dl>
    {s.bullets.map(([head, body]) => (
      <div class="border-t border-ink-200 first:border-0 pt-4 first:pt-0 pb-8 grid md:grid-cols-9 gap-x-8 gap-y-2">
        <dt class="md:col-span-3 text-lg font-medium">{head}</dt>
        <dd class="md:col-span-6 text-ink-700 leading-relaxed">{body}</dd>
      </div>
    ))}
  </dl>
</Section>

<Section id="install" nr="02" label={s.installLabel} tone="grey" title={s.install}>
  <div class="max-w-3xl">
    <div class="code-block" data-install-cmd>
      <span class="prompt">$</span>
      <code>{installCmd}</code>
      <button
        type="button"
        class="copy-btn"
        data-copy-target="install-cmd"
        data-default-label={s.secondary}
        data-copied-label={s.copied}
      >
        {s.secondary}
      </button>
    </div>
    <p class="label mt-3">{s.installNote}</p>
    <p class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
      <a href="https://github.com/Plaintext-Gmbh/projectmind" target="_blank" rel="noopener" class="link-arrow">{s.primary}</a>
      <a href="https://github.com/Plaintext-Gmbh/projectmind#quickstart" target="_blank" rel="noopener" class="link-arrow">{s.learnMore}</a>
    </p>
  </div>
</Section>

<script is:inline>
  // Click-to-copy for the install command.
  document.querySelectorAll('[data-copy-target="install-cmd"]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const block = btn.closest('[data-install-cmd]');
      const code = block?.querySelector('code')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        const copied = btn.getAttribute('data-copied-label') ?? 'copied';
        const def = btn.getAttribute('data-default-label') ?? 'copy';
        btn.textContent = copied;
        setTimeout(() => { btn.textContent = def; }, 1600);
      } catch {
        // Clipboard blocked, silent.
      }
    });
  });
</script>
