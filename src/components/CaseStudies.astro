---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).cases;
---

<section id="cases" class="py-24 md:py-32">
  <div class="max-w-6xl mx-auto px-6">
    <div class="reveal max-w-2xl mb-16">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-brand-500)] mb-4">{s.eyebrow}</p>
      <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight">{s.title}</h2>
      <p class="mt-5 text-lg text-[var(--color-ink-500)] leading-relaxed">{s.body}</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      {s.items.map((item, i) => (
        <article class="card reveal" style={`transition-delay: ${i * 60}ms;`}>
          <span class="inline-block font-mono text-xs uppercase tracking-wider px-2 py-1 rounded-md bg-[var(--color-ink-50)] border border-[var(--color-ink-100)] text-[var(--color-ink-700)] mb-3">
            {item.kicker}
          </span>
          <h3 class="text-xl font-bold mb-3">{item.title}</h3>
          <p class="text-[var(--color-ink-500)] leading-relaxed text-sm">{item.body}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {item.chips.map((c) => (
              <span class="chip-mono px-2.5 py-1 rounded-md bg-white border border-[var(--color-ink-100)] text-[var(--color-ink-700)]">{c}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
