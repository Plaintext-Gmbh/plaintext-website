---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';
import SectionHeader from './SectionHeader.astro';
import Keywords from './Keywords.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).cases;
---

<section id="cases" class="py-20 md:py-28 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} body={s.body} />

    <div class="grid md:grid-cols-2 gap-5">
      {s.items.map((item, i) => (
        <article class="card reveal flex flex-col" style={`transition-delay: ${i * 60}ms;`}>
          <p class="font-mono text-xs uppercase tracking-[0.15em] text-ink-500 mb-4">{item.kicker}</p>
          <h3 class="text-xl font-bold tracking-tight">{item.title}</h3>
          <p class="mt-2 text-ink-500 leading-relaxed flex-1">{item.body}</p>
          <Keywords items={item.chips} class="mt-5" />
        </article>
      ))}
    </div>
  </div>
</section>
