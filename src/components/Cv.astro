---
import type { Lang } from '../i18n/strings';
import { t, routes } from '../i18n/strings';
import { cv } from '../i18n/cv';
import Hero from './Hero.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = cv(lang);
const mail = t(lang).contact.button;
const base = import.meta.env.BASE_URL;
const lists = [s.focus, s.education, s.certificates, s.training, s.languages];
---

<Hero title={s.hero.title} label={s.hero.label} body={s.hero.body} facts={s.hero.facts} />

<div class="wrap py-16 md:py-24">
  <div class="max-w-4xl mx-auto space-y-14">
    <section>
      <h2 class="text-2xl font-semibold tracking-tight mb-5">{lists[0].title}</h2>
      <dl class="panel divide-y divide-ink-200 !py-2">
        {lists[0].items.map(([k, v]) => (
          <div class="py-4 grid md:grid-cols-4 gap-x-8 gap-y-1">
            <dt class="label">{k}</dt>
            <dd class="md:col-span-3 leading-relaxed">{v}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2 class="text-2xl font-semibold tracking-tight mb-5">{s.career.title}</h2>
      <dl class="panel divide-y divide-ink-200 !py-2">
        {s.career.items.map((item) => (
          <div class="py-4 grid md:grid-cols-4 gap-x-8 gap-y-1">
            <dt class="label">{item.period}</dt>
            <dd class="md:col-span-3">
              <p class="font-semibold">{item.role}</p>
              <p class="text-ink-500">{item.org}</p>
              {item.points.length > 0 && (
                <ul class="mt-3 space-y-1.5 list-disc pl-5 leading-relaxed">
                  {item.points.map((p) => <li>{p}</li>)}
                </ul>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    {lists.slice(1).map((list) => (
      <section>
        <h2 class="text-2xl font-semibold tracking-tight mb-5">{list.title}</h2>
        <dl class="panel divide-y divide-ink-200 !py-2">
          {list.items.map(([k, v]) => (
            <div class="py-3 grid md:grid-cols-4 gap-x-8 gap-y-1">
              <dt class="label">{k}</dt>
              <dd class="md:col-span-3 leading-relaxed">{v}</dd>
            </div>
          ))}
        </dl>
      </section>
    ))}

    <p class="panel flex flex-wrap gap-x-4 gap-y-1">
      <span class="label">{s.contact.label}</span>
      <a class="link-arrow" href={`mailto:${mail}`}>{mail}</a>
      <a class="link-arrow ml-auto" href={`${base}${routes.home[lang]}`}>{s.contact.back}</a>
    </p>
  </div>
</div>
