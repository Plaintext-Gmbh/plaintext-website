---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).tech;
---

<Section id="tech" nr="04" label={s.eyebrow} tone="grey" title={s.title} body={s.body}>
  <dl>
    {s.groups.map(([heading, tags]) => (
      <div class="border-t border-ink-200 py-4 grid md:grid-cols-9 gap-x-8 gap-y-1">
        <dt class="label md:col-span-3">{heading}</dt>
        <dd class="md:col-span-6 text-lg leading-relaxed">{tags.join(', ')}</dd>
      </div>
    ))}
  </dl>
</Section>
