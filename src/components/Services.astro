---
import type { Lang } from '../i18n/strings';
import { t, routes } from '../i18n/strings';
import SectionHeader from './SectionHeader.astro';
import Keywords from './Keywords.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).services;
const legacyHref = `${import.meta.env.BASE_URL}${routes.legacy[lang]}`;
---

<section id="services" class="py-20 md:py-28 bg-ink-50">
  <div class="max-w-6xl mx-auto px-5 sm:px-6">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} body={s.body} />

    <div class="grid md:grid-cols-2 gap-5">
      {s.items.map((item, i) => (
        <article class="card reveal flex flex-col" style={`transition-delay: ${i * 60}ms;`}>
          <div class="flex items-baseline justify-between gap-4 mb-5">
            <span class="font-mono text-xs text-ink-300">{String(i + 1).padStart(2, '0')}</span>
            {'kicker' in item && <span class="eyebrow">{item.kicker}</span>}
          </div>
          <h3 class="text-xl font-semibold tracking-tight">{item.title}</h3>
          <p class="mt-2 text-ink-500 leading-relaxed">{item.body}</p>
          <Keywords items={item.chips} class="mt-5" />
          {'link' in item && (
            <p class="mt-auto pt-5">
              <a href={legacyHref} class="link-arrow">
                {item.link}
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </p>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
