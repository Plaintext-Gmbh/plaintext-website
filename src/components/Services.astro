---
import type { Lang } from '../i18n/strings';
import { t, routes } from '../i18n/strings';
import Section from './Section.astro';
import Keywords from './Keywords.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).services;
const c = t(lang).calculator.teaser;
const base = import.meta.env.BASE_URL;
---

<Section id="services" label={s.eyebrow} title={s.title} body={s.body}>
  <div class="grid sm:grid-cols-2 gap-5">
    {s.items.map((item, i) => (
      <article class="panel flex flex-col">
        <p class="label flex justify-between gap-4">
          <span>{String(i + 1).padStart(2, '0')}</span>
          {'kicker' in item && <span class="text-brand-500">{item.kicker}</span>}
        </p>
        <h3 class="mt-5 text-xl font-semibold tracking-tight">{item.title}</h3>
        <p class="mt-2 text-ink-500 leading-relaxed">{item.body}</p>
        <Keywords items={item.chips} class="mt-4" />
        {'link' in item && (
          <p class="mt-auto pt-5">
            <a href={`${base}${routes[item.page][lang]}`} class="link-arrow text-sm">
              {item.link}
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </p>
        )}
      </article>
    ))}
  </div>

  <!-- Karte 2434: Preisrechner direkt unter dem Angebot (Seite nur deutsch, darum immer die DE-Route). -->
  <a href={`${base}${routes.calculator.de}`} class="panel mt-5 flex flex-col md:flex-row md:items-center gap-4 md:gap-10 hover:ring-1 hover:ring-brand-500">
    <div class="min-w-0">
      <p class="label text-brand-500">{c.kicker}</p>
      <h3 class="mt-3 text-xl font-semibold tracking-tight">{c.title}</h3>
      <p class="mt-2 text-ink-500 leading-relaxed">{c.body}</p>
    </div>
    <span class="btn md:ml-auto self-start md:self-center">{c.link}</span>
  </a>
</Section>
