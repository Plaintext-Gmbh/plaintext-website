---
import type { Lang } from '../i18n/strings';
import { t, routes } from '../i18n/strings';
import Section from './Section.astro';
import Keywords from './Keywords.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).services;
const base = import.meta.env.BASE_URL;
---

<Section id="services" nr="01" label={s.eyebrow} tone="grey" title={s.title} body={s.body}>
  <div class="grid sm:grid-cols-2 gap-x-10">
    {s.items.map((item, i) => (
      <article class="border-t border-ink-200 pt-4 pb-10 flex flex-col">
        <p class="label flex justify-between gap-4">
          <span>{String(i + 1).padStart(2, '0')}</span>
          {'kicker' in item && <span class="text-brand-500">{item.kicker}</span>}
        </p>
        <h3 class="mt-6 text-2xl font-medium tracking-tight">{item.title}</h3>
        <p class="mt-3 text-ink-700 leading-relaxed">{item.body}</p>
        <Keywords items={item.chips} class="mt-4" />
        {'link' in item && (
          <p class="mt-auto pt-5">
            <a href={`${base}${routes[item.page][lang]}`} class="link-arrow">
              {item.link}
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </p>
        )}
      </article>
    ))}
  </div>
</Section>
