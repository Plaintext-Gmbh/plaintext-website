---
// Karte 2434: Verweis auf den Preisrechner (Startseite unter dem Angebot, Legacy-Seite).
import type { Lang } from '../i18n/strings';
import { t, routes } from '../i18n/strings';

interface Props {
  lang: Lang;
  class?: string;
}
const { lang, class: cls = '' } = Astro.props;
const c = t(lang).calculator.teaser;
const base = import.meta.env.BASE_URL;
---

<a href={`${base}${routes.calculator[lang]}`} class={`panel flex flex-col md:flex-row md:items-center gap-4 md:gap-10 hover:ring-1 hover:ring-brand-500 ${cls}`}>
  <div class="min-w-0">
    <p class="label text-brand-500">{c.kicker}</p>
    <h3 class="mt-3 text-xl font-semibold tracking-tight">{c.title}</h3>
    <p class="mt-2 text-ink-500 leading-relaxed">{c.body}</p>
  </div>
  <span class="btn md:ml-auto self-start md:self-center">{c.link}</span>
</a>
