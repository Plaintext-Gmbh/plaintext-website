---
import Brand from './Brand.astro';
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).nav;
const otherLang = lang === 'de' ? 'en' : 'de';
const otherHref = lang === 'de' ? '/en/' : '/';
const homeHref = lang === 'de' ? '/' : '/en/';
---

<nav class="fixed inset-x-0 top-0 z-50 backdrop-blur bg-white/80 border-b border-[var(--color-ink-100)]">
  <div class="max-w-6xl mx-auto px-6 py-3 flex items-center gap-6">
    <Brand href={homeHref} />

    <div class="hidden md:flex items-center gap-1 text-sm font-medium ml-auto text-[var(--color-ink-700)]">
      <a href="#projectmind" class="px-3 py-1.5 rounded-md hover:text-[var(--color-brand-500)] transition">{s.projectmind}</a>
      <a href="#services" class="px-3 py-1.5 rounded-md hover:text-[var(--color-brand-500)] transition">{s.services}</a>
      <a href="#tech" class="px-3 py-1.5 rounded-md hover:text-[var(--color-brand-500)] transition">{s.tech}</a>
      <a href="#team" class="px-3 py-1.5 rounded-md hover:text-[var(--color-brand-500)] transition">{s.team}</a>
    </div>

    <div class="flex items-center gap-3 ml-auto md:ml-0">
      <a
        href={otherHref}
        class="text-xs font-mono uppercase tracking-wider text-[var(--color-ink-500)] hover:text-[var(--color-brand-500)] transition"
        title={otherLang === 'de' ? 'Auf Deutsch' : 'In English'}
      >
        <span class="text-[var(--color-ink-300)]">{lang}</span>
        <span aria-hidden="true">·</span>
        <span>{otherLang}</span>
      </a>
      <a href="#contact" class="btn btn-primary !py-2 !px-3 text-sm">{s.cta}</a>
    </div>
  </div>
</nav>
