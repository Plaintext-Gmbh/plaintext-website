---
import Brand from './Brand.astro';
import type { Lang, Page } from '../i18n/strings';
import { t, routes } from '../i18n/strings';

interface Props {
  lang: Lang;
  page?: Page;
}
const { lang, page = 'home' } = Astro.props;
const s = t(lang).nav;
const otherLang = lang === 'de' ? 'en' : 'de';
const base = import.meta.env.BASE_URL;
const homeHref = `${base}${routes.home[lang]}`;
const otherHref = `${base}${routes[page][otherLang]}`;

// Anker tragen die Start-URL als Präfix, damit sie auch von Unterseiten funktionieren.
const links = [
  { href: `${homeHref}#services`, label: s.services },
  { href: `${base}${routes.legacy[lang]}`, label: s.legacy, current: page === 'legacy' },
  { href: `${homeHref}#cases`, label: s.cases },
  { href: `${homeHref}#projectmind`, label: s.projectmind },
  { href: `${homeHref}#tech`, label: s.tech },
  { href: `${homeHref}#team`, label: s.team },
];
---

<nav class="fixed inset-x-0 top-0 z-50 bg-[#fcfbf8]/90 backdrop-blur border-b border-ink-100" aria-label={s.menu}>
  <div class="max-w-6xl mx-auto px-5 sm:px-6 h-16 flex items-center gap-6">
    <Brand href={homeHref} />

    <ul class="hidden lg:flex items-center gap-6 ml-auto text-sm text-ink-700">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            aria-current={l.current ? 'page' : undefined}
            class={`hover:text-brand-500 transition-colors ${l.current ? 'text-brand-500 font-medium' : ''}`}
          >{l.label}</a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3 sm:gap-4 ml-auto lg:ml-0">
      <a
        href={otherHref}
        hreflang={otherLang}
        title={otherLang === 'de' ? 'Auf Deutsch' : 'In English'}
        class="font-mono text-xs uppercase tracking-wider text-ink-500 hover:text-ink-900 transition-colors p-2"
      >
        {otherLang}
      </a>
      <a href={`${homeHref}#contact`} class="btn btn-primary btn-sm hidden sm:inline-flex">{s.cta}</a>

      <!-- Mobiles Menü ohne JavaScript: details/summary. -->
      <details class="lg:hidden" data-mobile-menu>
        <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer p-2 -mr-2 text-ink-900" aria-label={s.menu}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <ul class="absolute inset-x-0 top-16 bg-[#fcfbf8] border-b border-ink-100 shadow-lg px-5 sm:px-6 py-3 text-base text-ink-900">
          {links.map((l) => (
            <li class="border-b border-ink-100 last:border-0">
              <a href={l.href} aria-current={l.current ? 'page' : undefined} class="block py-3">{l.label}</a>
            </li>
          ))}
          <li><a href={`${homeHref}#contact`} class="block py-3 font-medium text-brand-500">{s.cta}</a></li>
        </ul>
      </details>
    </div>
  </div>
</nav>

<script is:inline>
  // Menü nach Klick auf einen Link schliessen (Anker auf derselben Seite laden nicht neu).
  document.querySelectorAll('[data-mobile-menu] a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details').removeAttribute('open'))
  );
</script>
