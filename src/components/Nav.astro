---
import Brand from './Brand.astro';
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).nav;
const otherLang = lang === 'de' ? 'en' : 'de';
const base = import.meta.env.BASE_URL;
const enHref = `${base}en/`;
const homeHref = lang === 'de' ? base : enHref;
const otherHref = lang === 'de' ? enHref : base;

// Anchors are prefixed with the home URL so they also work from /impressum/.
const links = [
  ['services', s.services],
  ['cases', s.cases],
  ['projectmind', s.projectmind],
  ['tech', s.tech],
  ['team', s.team],
] as const;
---

<nav class="fixed inset-x-0 top-0 z-50 bg-white/85 backdrop-blur border-b border-ink-100">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center gap-8">
    <Brand href={homeHref} />

    <ul class="hidden md:flex items-center gap-7 ml-auto text-sm font-medium text-ink-700">
      {links.map(([id, label]) => (
        <li><a href={`${homeHref}#${id}`} class="hover:text-brand-500 transition-colors">{label}</a></li>
      ))}
    </ul>

    <div class="flex items-center gap-4 ml-auto md:ml-0">
      <a
        href={otherHref}
        hreflang={otherLang}
        title={otherLang === 'de' ? 'Auf Deutsch' : 'In English'}
        class="font-mono text-xs uppercase tracking-wider text-ink-500 hover:text-ink-900 transition-colors"
      >
        {otherLang}
      </a>
      <a href={`${homeHref}#contact`} class="btn btn-primary btn-sm">{s.cta}</a>
    </div>
  </div>
</nav>
