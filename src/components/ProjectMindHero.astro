---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';
import GitHubIcon from './GitHubIcon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).pm;
const base = import.meta.env.BASE_URL;
const installCmd = 'curl -fsSL https://raw.githubusercontent.com/Plaintext-Gmbh/projectmind/master/scripts/install.sh | sh';
---

<section id="projectmind" class="py-20 md:py-28 bg-ink-900 text-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="reveal max-w-3xl">
      <div class="flex items-center gap-3 mb-6">
        <img src={`${base}projectmind-icon.svg`} alt="" class="w-8 h-8" aria-hidden="true" width="32" height="32" />
        <p class="eyebrow text-brand-300">
          {s.eyebrow}
          <span class="mx-2 text-white/30">·</span>
          {s.kicker}
        </p>
      </div>

      <h2 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight">{s.title}</h2>
      <p class="mt-3 text-xl md:text-2xl text-brand-300">{s.subtitle}</p>
      <p class="mt-6 text-lg text-white/70 leading-relaxed max-w-2xl">{s.body}</p>
    </div>

    <div class="mt-14 grid md:grid-cols-2 gap-10 lg:gap-16 items-start">
      <ul class="space-y-6 reveal min-w-0" style="transition-delay: 80ms;">
        {s.bullets.map(([head, body]) => (
          <li class="flex gap-4">
            <span class="mt-[0.6rem] w-1.5 h-1.5 rounded-full bg-brand-300 flex-shrink-0" aria-hidden="true"></span>
            <div class="min-w-0">
              <div class="font-semibold">{head}</div>
              <div class="mt-1 text-sm text-white/60 leading-relaxed">{body}</div>
            </div>
          </li>
        ))}
      </ul>

      <div class="reveal min-w-0" style="transition-delay: 160ms;">
        <p class="font-mono text-xs uppercase tracking-[0.15em] text-white/50 mb-3">{s.install}</p>

        <div class="code-block" data-install-cmd>
          <span class="prompt">$</span>
          <code>{installCmd}</code>
          <button
            type="button"
            class="copy-btn"
            data-copy-target="install-cmd"
            data-default-label={s.secondary}
            data-copied-label={s.copied}
          >
            {s.secondary}
          </button>
        </div>

        <p class="mt-3 text-sm text-white/50">{s.installNote}</p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href="https://github.com/Plaintext-Gmbh/projectmind" target="_blank" rel="noopener" class="btn btn-on-dark">
            <GitHubIcon />
            {s.primary}
          </a>
          <a href="https://github.com/Plaintext-Gmbh/projectmind#quickstart" target="_blank" rel="noopener" class="btn btn-ghost-on-dark">
            {s.learnMore}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Click-to-copy for the install command.
  document.querySelectorAll('[data-copy-target="install-cmd"]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const block = btn.closest('[data-install-cmd]');
      const code = block?.querySelector('code')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        const copied = btn.getAttribute('data-copied-label') ?? 'copied';
        const def = btn.getAttribute('data-default-label') ?? 'copy';
        btn.textContent = copied;
        setTimeout(() => { btn.textContent = def; }, 1600);
      } catch {
        // Clipboard blocked, silent.
      }
    });
  });
</script>
