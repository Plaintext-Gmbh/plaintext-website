---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';
import Keywords from './Keywords.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).hero;
---

<section class="pt-32 pb-16 md:pt-44 md:pb-24">
  <div class="max-w-6xl mx-auto px-5 sm:px-6">
    <div class="max-w-3xl reveal">
      <p class="eyebrow mb-6">{s.eyebrow}</p>
      <h1 class="text-[2.6rem] sm:text-6xl md:text-7xl display !leading-[1.05]">
        <span class="block">{s.title1}</span>
        <span class="block text-brand-700">{s.title2}</span>
      </h1>
      <p class="mt-7 text-lg md:text-xl text-ink-500 leading-relaxed max-w-2xl">{s.body}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="#services" class="btn btn-primary">
          {s.primary}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#projectmind" class="btn btn-secondary">{s.secondary}</a>
      </div>
    </div>

    <Keywords items={s.facts} class="mt-14 pt-6 border-t border-ink-200 reveal" />
  </div>
</section>
