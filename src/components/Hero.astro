---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).hero;
---

<section class="relative pt-32 pb-24 md:pt-40 md:pb-32 overflow-hidden">
  <div class="absolute inset-0 grid-backdrop pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-6xl mx-auto px-6">
    <div class="grid md:grid-cols-12 gap-10 items-center">
      <div class="md:col-span-7 reveal">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-brand-500)] mb-6">
          {s.eyebrow}
        </p>
        <h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold leading-[1.02] tracking-tight">
          <span class="block">{s.title1}</span>
          <span class="block text-[var(--color-brand-500)]">{s.title2}</span>
          <span class="block text-[var(--color-ink-500)] font-light italic mt-1">{s.title3}</span>
        </h1>
        <p class="mt-8 text-lg md:text-xl text-[var(--color-ink-500)] max-w-2xl leading-relaxed">
          {s.body}
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="#services" class="btn btn-primary">
            {s.primary}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="#projectmind" class="btn btn-secondary">{s.secondary}</a>
        </div>
        <div class="mt-10 flex flex-wrap gap-2">
          {s.badges.map((b) => (
            <span class="chip-mono px-2.5 py-1 rounded-md bg-[var(--color-brand-50)] text-[var(--color-brand-700)] border border-[var(--color-brand-100)]">
              {b}
            </span>
          ))}
        </div>
      </div>

      <div class="md:col-span-5 reveal" style="transition-delay: 120ms;">
        <div class="relative aspect-square max-w-[420px] mx-auto">
          <!-- A schematic node graph evoking ProjectMind's bean/architecture
               graph, without being a literal screenshot. Lines + nodes
               in brand colour, gentle blink animation. -->
          <svg viewBox="0 0 400 400" class="absolute inset-0 w-full h-full" role="img" aria-label={t(lang).pm.diagramAria}>
            <defs>
              <linearGradient id="lineGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="var(--color-brand-500)" stop-opacity="0.6"/>
                <stop offset="100%" stop-color="var(--color-brand-300)" stop-opacity="0.2"/>
              </linearGradient>
            </defs>
            <g stroke="url(#lineGrad)" stroke-width="1.5" fill="none">
              <path d="M200 60 L120 160" />
              <path d="M200 60 L280 160" />
              <path d="M120 160 L80 280" />
              <path d="M120 160 L200 240" />
              <path d="M280 160 L200 240" />
              <path d="M280 160 L320 280" />
              <path d="M200 240 L160 340" />
              <path d="M200 240 L240 340" />
              <path d="M80 280 L160 340" />
              <path d="M320 280 L240 340" />
            </g>
            <g>
              <circle class="graph-node" cx="200" cy="60"  r="14" fill="var(--color-brand-500)" />
              <circle class="graph-node" cx="120" cy="160" r="11" fill="var(--color-brand-700)" />
              <circle class="graph-node" cx="280" cy="160" r="11" fill="var(--color-brand-700)" />
              <circle class="graph-node" cx="80"  cy="280" r="9"  fill="var(--color-accent-mint)" />
              <circle class="graph-node" cx="200" cy="240" r="13" fill="var(--color-brand-500)" />
              <circle class="graph-node" cx="320" cy="280" r="9"  fill="var(--color-accent-amber)" />
              <circle class="graph-node" cx="160" cy="340" r="8"  fill="var(--color-ink-700)" />
              <circle class="graph-node" cx="240" cy="340" r="8"  fill="var(--color-ink-700)" />
            </g>
            <!-- floating label hints, mono -->
            <g font-family="JetBrains Mono, monospace" font-size="10" fill="var(--color-ink-500)">
              <text x="208" y="50">RepoEngine</text>
              <text x="20" y="155">JavaPlugin</text>
              <text x="288" y="155">RustPlugin</text>
              <text x="208" y="234">DiagramRouter</text>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>
