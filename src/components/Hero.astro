---
// Seitenkopf: dunkle Fläche, zentriert, ohne Buttons.
interface Props {
  title: string;
  title2?: string;
  label: string;
  facts?: readonly string[];
  body?: string;
}
const { title, title2, label, facts = [], body } = Astro.props;
---

<section class="tone-dark pt-32 md:pt-44 pb-16 md:pb-24">
  <div class="wrap text-center">
    <p class="label text-brand-500">{label}</p>
    <h1 class="display mt-5 text-4xl sm:text-5xl md:text-6xl max-w-4xl mx-auto">
      <span class="block">{title}</span>
      {title2 && <span class="block text-ink-500">{title2}</span>}
    </h1>
    {body && <p class="mt-7 text-lg md:text-xl text-ink-700 leading-relaxed max-w-2xl mx-auto">{body}</p>}
    {facts.length > 0 && (
      <ul class="keywords justify-center mt-10">{facts.map((f) => <li>{f}</li>)}</ul>
    )}
  </div>
</section>
