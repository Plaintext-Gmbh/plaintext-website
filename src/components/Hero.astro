---
// Seitenkopf: grosser Titel, darunter Randspalte mit Eckdaten und der Einleitungstext.
interface Props {
  title: string;
  title2?: string;
  label: string;
  facts?: readonly string[];
  body?: string;
}
const { title, title2, label, facts = [], body } = Astro.props;
---

<section class="pt-28 md:pt-44 pb-14 md:pb-24">
  <div class="wrap">
    <h1 class="display text-[clamp(2.1rem,7.6vw,6.5rem)] max-w-6xl">
      <span class="block">{title}</span>
      {title2 && <span class="block text-brand-500">{title2}</span>}
    </h1>
    <div class="mt-10 md:mt-20 grid md:grid-cols-12 gap-x-8 gap-y-8">
      <div class="label md:col-span-3 order-2 md:order-1">
        <p class="text-ink-900">{label}</p>
        {facts.length > 0 && <ul class="mt-2">{facts.map((f) => <li>{f}</li>)}</ul>}
      </div>
      {body && <p class="md:col-span-8 order-1 md:order-2 text-xl md:text-2xl leading-snug">{body}</p>}
    </div>
  </div>
</section>
