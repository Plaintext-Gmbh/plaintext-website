---
import Brand from './Brand.astro';
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).footer;
const base = import.meta.env.BASE_URL;
const homeHref = lang === 'de' ? base : `${base}en/`;
const imprintHref = `${base}${s.imprintHref}`;
---

<footer class="bg-ink-900 text-ink-300 py-10">
  <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row md:items-center gap-5 md:gap-8 font-mono text-xs">
    <Brand href={homeHref} size="1.1rem" invert />

    <p class="md:ml-auto text-ink-500">© {new Date().getFullYear()} {s.impressum}</p>

    <nav class="flex items-center gap-5" aria-label="Footer">
      <a href={imprintHref} class="hover:text-white transition-colors">{s.imprintLabel}</a>
      <a href="https://github.com/Plaintext-Gmbh" target="_blank" rel="noopener" class="hover:text-white transition-colors">
        github.com/Plaintext-Gmbh
      </a>
    </nav>
  </div>
</footer>
