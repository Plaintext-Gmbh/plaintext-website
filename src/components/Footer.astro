---
import Brand from './Brand.astro';
import type { Lang } from '../i18n/strings';
import { t, routes } from '../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const s = d.footer;
const base = import.meta.env.BASE_URL;
const homeHref = `${base}${routes.home[lang]}`;
const pages = [
  { href: `${homeHref}#services`, label: d.nav.services },
  { href: `${base}${routes.legacy[lang]}`, label: d.nav.legacy },
  { href: `${base}${routes.projectmind[lang]}`, label: d.nav.projectmind },
  { href: `${homeHref}#team`, label: d.nav.team },
  { href: `${base}${routes.imprint[lang]}`, label: s.imprintLabel },
];
---

<footer class="tone-dark">
  <div class="wrap">
    <div class="pt-10 pb-10 grid sm:grid-cols-2 md:grid-cols-12 gap-x-8 gap-y-8 text-sm">
      <div class="sm:col-span-2 md:col-span-3">
        <Brand href={homeHref} size="1.1rem" />
      </div>

      <nav class="md:col-span-4" aria-label={s.pagesTitle}>
        <h2 class="label mb-2">{s.pagesTitle}</h2>
        <ul class="space-y-1.5">
          {pages.map((p) => (
            <li><a href={p.href} class="hover:text-brand-500">{p.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="md:col-span-5">
        <h2 class="label mb-2">{s.contactTitle}</h2>
        <ul class="space-y-1.5">
          <li><a href={`mailto:${d.contact.button}`} class="hover:text-brand-500">{d.contact.button}</a></li>
          <li>{d.contact.address}</li>
          <li>
            <a href="https://github.com/Plaintext-Gmbh" target="_blank" rel="noopener" class="hover:text-brand-500">
              github.com/Plaintext-Gmbh
            </a>
          </li>
        </ul>
        <p class="label mt-8">© {new Date().getFullYear()} {s.impressum}</p>
      </div>
    </div>
  </div>
</footer>
