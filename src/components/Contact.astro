---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const s = d.contact;
---

<section id="contact">
  <div class="wrap py-16 md:py-24">
    <div class="border-2 border-brand-500 rounded-3xl px-6 py-14 md:py-20 text-center">
      <p class="label text-brand-500">{d.nav.contact}</p>
      <h2 class="display mt-3 text-3xl md:text-4xl">{s.title}</h2>
      <p class="mt-4 text-lg text-ink-500 leading-relaxed max-w-xl mx-auto">{s.body}</p>
      <a href={`mailto:${s.button}`} class="btn mt-8 !px-6 !py-3.5 !text-base">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
        {s.button}
      </a>
      <p class="label mt-8">{s.address}</p>
    </div>
  </div>
</section>
