---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';
import Section from './Section.astro';

interface Props {
  lang: Lang;
  nr: string;
}
const { lang, nr } = Astro.props;
const d = t(lang);
const s = d.contact;
---

<Section id="contact" nr={nr} label={d.nav.contact} tone="blue" title={s.title} body={s.body}>
  <a
    href={`mailto:${s.button}`}
    class="display text-[clamp(1.75rem,6vw,4.5rem)] text-brand-500 hover:text-brand-700 underline decoration-2 underline-offset-[0.18em]"
  >{s.button}</a>
  <p class="label mt-8">{s.address}</p>
</Section>
