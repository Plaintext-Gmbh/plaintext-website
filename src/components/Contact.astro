---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).contact;
---

<section id="contact" class="py-24 md:py-32 bg-brand-700 text-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-3xl reveal">
      <p class="eyebrow text-brand-300 mb-4">{s.eyebrow}</p>
      <h2 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight">{s.title}</h2>
      <p class="mt-5 text-lg md:text-xl text-white/75 leading-relaxed max-w-2xl">{s.body}</p>

      <a href={`mailto:${s.button}`} class="btn btn-on-dark mt-9 !px-6 !py-3.5 text-base md:text-lg">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
        {s.button}
      </a>

      <p class="mt-10 font-mono text-xs text-white/55">{s.address}</p>
    </div>
  </div>
</section>
