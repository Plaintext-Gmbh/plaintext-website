---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';
import Section from './Section.astro';
import Keywords from './Keywords.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).team;
const base = import.meta.env.BASE_URL;
const people = [
  { ...s.daniel, img: 'daniel.jpg' },
  { ...s.jasmin, img: 'jasmin.jpg' },
];
---

<Section id="team" label={s.eyebrow} title={s.title}>
  <div class="grid md:grid-cols-2 gap-5">
    {people.map((p) => (
      <div class="panel flex flex-col sm:flex-row gap-6">
        <img
          src={`${base}${p.img}`}
          alt={p.name}
          width="144"
          height="144"
          loading="lazy"
          class="w-28 h-28 sm:w-36 sm:h-36 rounded-xl object-cover flex-shrink-0"
        />
        <div class="min-w-0">
          <p class="label">{p.role}</p>
          <h3 class="mt-1 text-xl font-semibold tracking-tight">{p.name}</h3>
          <p class="mt-3 text-ink-500 leading-relaxed">{p.body}</p>
          <Keywords items={p.chips} class="mt-4" />
        </div>
      </div>
    ))}
  </div>
</Section>
