---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';
import SectionHeader from './SectionHeader.astro';
import Keywords from './Keywords.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).team;
const base = import.meta.env.BASE_URL;
const people = [
  { ...s.daniel, img: 'daniel.jpg' },
  { ...s.jasmin, img: 'jasmin.jpg' },
];
---

<section id="team" class="py-20 md:py-28 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} />

    <div class="grid md:grid-cols-2 gap-10 lg:gap-16">
      {people.map((p, i) => (
        <div class="reveal flex flex-col sm:flex-row gap-6" style={`transition-delay: ${i * 60}ms;`}>
          <img
            src={`${base}${p.img}`}
            alt={p.name}
            width="160"
            height="160"
            loading="lazy"
            class="w-32 h-32 sm:w-40 sm:h-40 rounded-xl object-cover flex-shrink-0"
          />
          <div class="min-w-0">
            <p class="eyebrow mb-2">{p.role}</p>
            <h3 class="text-2xl font-extrabold tracking-tight">{p.name}</h3>
            <p class="mt-3 text-ink-500 leading-relaxed">{p.body}</p>
            <Keywords items={p.chips} class="mt-4" />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
