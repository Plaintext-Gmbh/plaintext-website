---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';
import Section from './Section.astro';
import Keywords from './Keywords.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).team;
const base = import.meta.env.BASE_URL;
const people = [
  { ...s.daniel, img: 'daniel.jpg' },
  { ...s.jasmin, img: 'jasmin.jpg' },
];
---

<Section id="team" nr="05" label={s.eyebrow} title={s.title}>
  <div class="grid sm:grid-cols-2 gap-x-10 gap-y-12">
    {people.map((p) => (
      <div>
        <img
          src={`${base}${p.img}`}
          alt={p.name}
          width="320"
          height="320"
          loading="lazy"
          class="w-full max-w-xs aspect-square object-cover"
        />
        <p class="label mt-5">{p.role}</p>
        <h3 class="mt-1 text-2xl font-medium tracking-tight">{p.name}</h3>
        <p class="mt-3 text-ink-700 leading-relaxed">{p.body}</p>
        <Keywords items={p.chips} class="mt-4" />
      </div>
    ))}
  </div>
</Section>
