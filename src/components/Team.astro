---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).team;
---

<section id="team" class="py-24 md:py-32 bg-[var(--color-ink-50)]">
  <div class="max-w-5xl mx-auto px-6">
    <div class="reveal max-w-2xl mb-16">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-brand-500)] mb-4">{s.eyebrow}</p>
      <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight">{s.title}</h2>
    </div>

    <div class="grid md:grid-cols-12 gap-10 items-center mb-16 reveal">
      <div class="md:col-span-4">
        <div class="relative w-48 h-48 md:w-full md:h-auto md:aspect-square rounded-2xl overflow-hidden shadow-2xl ring-1 ring-[var(--color-brand-100)]">
          <img src="/daniel.jpg" alt={s.daniel.name} class="w-full h-full object-cover" />
          <div
            class="absolute inset-x-0 bottom-0 p-3 text-xs font-mono text-white"
            style="background: linear-gradient(to top, rgba(13,12,77,0.85), transparent);"
          >
            DM
          </div>
        </div>
      </div>
      <div class="md:col-span-8">
        <p class="text-xs font-mono uppercase tracking-wider text-[var(--color-brand-500)] mb-2">{s.daniel.role}</p>
        <h3 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-5">{s.daniel.name}</h3>
        <p class="text-[var(--color-ink-700)] leading-relaxed text-lg">{s.daniel.body}</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {s.daniel.chips.map((c) => (
            <span class="chip-mono px-2.5 py-1 rounded-md bg-white border border-[var(--color-ink-100)] text-[var(--color-ink-700)]">{c}</span>
          ))}
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-12 gap-10 items-center reveal">
      <div class="md:col-span-8 md:order-1 order-2">
        <p class="text-xs font-mono uppercase tracking-wider text-[var(--color-brand-500)] mb-2">{s.jasmin.role}</p>
        <h3 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-5">{s.jasmin.name}</h3>
        <p class="text-[var(--color-ink-700)] leading-relaxed text-lg">{s.jasmin.body}</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {s.jasmin.chips.map((c) => (
            <span class="chip-mono px-2.5 py-1 rounded-md bg-white border border-[var(--color-ink-100)] text-[var(--color-ink-700)]">{c}</span>
          ))}
        </div>
      </div>
      <div class="md:col-span-4 md:order-2 order-1">
        <div class="relative w-48 h-48 md:w-full md:h-auto md:aspect-square rounded-2xl overflow-hidden shadow-2xl ring-1 ring-[var(--color-brand-100)]">
          <img src="/jasmin.jpg" alt={s.jasmin.name} class="w-full h-full object-cover" />
          <div
            class="absolute inset-x-0 bottom-0 p-3 text-xs font-mono text-white"
            style="background: linear-gradient(to top, rgba(13,12,77,0.85), transparent);"
          >
            JM
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
