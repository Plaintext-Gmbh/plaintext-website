---
interface Props {
  size?: string;
  invert?: boolean;
  href?: string;
}
const base = import.meta.env.BASE_URL;
const { size = '1.35rem', invert = false, href = base } = Astro.props;
---

<a
  href={href}
  class="wordmark"
  style={`font-size: ${size}; color: ${invert ? 'white' : 'var(--color-ink-900)'};`}
  aria-label="Plaintext GmbH"
>
  <img src={`${base}projectmind-icon.svg`} alt="" class="mark-icon" aria-hidden="true" width="24" height="24" />
  <span>plaintext<span class={invert ? 'text-brand-300' : 'text-brand-500'}>.</span></span>
</a>
