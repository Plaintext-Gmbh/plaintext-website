---
interface Props {
  size?: string;
  /** Einfarbiges Signet (weisser Rand, weisser Pfeil) für dunkle Flächen. */
  mono?: boolean;
  href?: string;
}
const base = import.meta.env.BASE_URL;
const { size = '1.35rem', mono = false, href = base } = Astro.props;
---

<a href={href} class="wordmark" style={`font-size: ${size}; color: var(--color-ink-900);`} aria-label="Plaintext GmbH">
  {mono ? (
    <svg class="mark-icon" viewBox="0 0 100 100" aria-hidden="true">
      <circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="7" />
      <path d="M50 18 L78 46 A6 6 0 0 1 73.8 56.2 L62 56.2 L62 76 A4 4 0 0 1 58 80 L42 80 A4 4 0 0 1 38 76 L38 56.2 L26.2 56.2 A6 6 0 0 1 22 46 Z" fill="currentColor" />
    </svg>
  ) : (
    <img src={`${base}projectmind-icon.svg`} alt="" class="mark-icon" aria-hidden="true" width="24" height="24" />
  )}
  <span>plaintext</span>
</a>
