---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';
import Section from './Section.astro';
import Keywords from './Keywords.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang).cases;
// Die GIS-Referenz der Legacy-Seite steht auch hier, ohne den Text zu duplizieren.
const items = [t(lang).legacy.reference, ...s.items];
---

<Section id="cases" label={s.eyebrow} tone="grey" title={s.title} body={s.body}>
  <div class="space-y-5">
    {items.map((item) => (
      <article class="panel grid md:grid-cols-5 gap-x-10 gap-y-3">
        <div class="md:col-span-2">
          <p class="label">{item.kicker}</p>
          <h3 class="mt-2 text-xl font-semibold tracking-tight">{item.title}</h3>
        </div>
        <div class="md:col-span-3">
          <p class="text-ink-500 leading-relaxed">{item.body}</p>
          <Keywords items={item.chips} class="mt-4" />
        </div>
      </article>
    ))}
  </div>
</Section>
