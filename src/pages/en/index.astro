---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Services from '../../components/Services.astro';
import CaseStudies from '../../components/CaseStudies.astro';
import ProjectMindHero from '../../components/ProjectMindHero.astro';
import OtherProducts from '../../components/OtherProducts.astro';
import TechStack from '../../components/TechStack.astro';
import Team from '../../components/Team.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

const lang = 'en' as const;
---

<Layout lang={lang}>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <Services lang={lang} />
    <CaseStudies lang={lang} />
    <ProjectMindHero lang={lang} />
    <OtherProducts lang={lang} />
    <TechStack lang={lang} />
    <Team lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
