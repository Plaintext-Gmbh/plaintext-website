---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import ProjectMind from '../../components/ProjectMind.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { t } from '../../i18n/strings';

const lang = 'en' as const;
const meta = t(lang).pm.meta;
---

<Layout lang={lang} page="projectmind" title={meta.title} description={meta.description}>
  <Nav lang={lang} page="projectmind" />
  <main>
    <ProjectMind lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
