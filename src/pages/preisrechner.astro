<script is:inline>
(() => {
'use strict';
/* ---------- Konfiguration ---------- */
const CFG = {
  endpoint: document.getElementById('pocForm').action,   // public/api/poc.php
  cap: 150000, floor: 18000,
  maxZipMB: 20,          // geht als Mail-Anhang mit, darum nicht grösser
};
const S = { loc: 60000, langs: 2, ui: 'web', mig: 'platform', sqale: 3, rel: 2, sec: 2, dup: 8, cov: 15,
            ifaces: 4, dbs: 1, docs: 'partial', knowledge: true, dataMig: false, rate: 1500, team: 2 };
let R = {};

const $ = id => document.getElementById(id);
const chf = n => 'CHF ' + Math.round(n).toLocaleString('de-CH').replace(/,/g, '’');
const tchf = n => (Math.round(n / 1000)).toLocaleString('de-CH');
const fmtInt = n => Math.round(n).toLocaleString('de-CH').replace(/,/g, '’');
const RL = ['A','B','C','D','E'];

/* ---------- LOC log slider ---------- */
const LMIN = Math.log(1000), LMAX = Math.log(1000000);
const toSlider = v => Math.round((Math.log(v) - LMIN) / (LMAX - LMIN) * 1000);
const fromSlider = s => { const v = Math.exp(LMIN + s / 1000 * (LMAX - LMIN)); const st = v < 20000 ? 500 : v < 100000 ? 1000 : 5000; return Math.round(v / st) * st; };

/* ---------- Modell ---------- */
function compute() {
  const kloc = S.loc / 1000;
  const effK = kloc * (1 - 0.5 * S.dup / 100);
  const qual = [0.85, 0.95, 1.05, 1.18, 1.32][S.sqale - 1] * (1 + 0.035 * (S.rel - 1)) * (1 + 0.035 * (S.sec - 1));
  const tech = 1 + 0.08 * (S.langs - 1);
  const core = 3.0 * Math.pow(effK, 0.6) * qual * tech;
  const migF = { upgrade: 0.75, platform: 1.0, language: 1.4 }[S.mig];
  const uiF = { none: 0.9, web: 1.0, rich: 1.2 }[S.ui];
  const docF = { good: 0.85, partial: 1.0, none: 1.2 }[S.docs];
  const p = [
    4 + 0.16 * core * docF * (S.knowledge ? 1 : 1.2) + 0.5 * S.dbs,
    0.3 * core * (1.25 - 0.6 * S.cov / 100) * uiF,
    S.ifaces + S.dbs > 0 ? 1.5 + 1.4 * S.ifaces + 1.0 * S.dbs : 0,
    0.55 * core * migF * uiF + (S.dataMig ? 3 + 0.1 * core + 1.5 * S.dbs : 0),
    3 + 0.06 * core,
  ];
  const pt = p.reduce((a, b) => a + b, 0);
  const mid = Math.max(CFG.floor, pt * S.rate);
  const low = Math.max(CFG.floor, mid * 0.9), high = mid * (1.12 + (S.docs === 'none' ? 0.05 : 0) + (S.knowledge ? 0 : 0.05));
  const etappen = Math.min(10, Math.max(2, Math.round(effK / 25) + 2));
  const weeks = pt / (S.team * 4);
  R = { p, pt, mid, low, high, etappen, weeks, mocks: S.ifaces, over: low > CFG.cap, partOver: high > CFG.cap && low <= CFG.cap };
  return R;
}

/* ---------- Render Ergebnis ---------- */
const PH = ['Analyse und Geschäftskontext', 'Testset als Sicherheitsnetz', 'Mocks der Umsysteme', 'Migration in Etappen', 'Übergabe'];
function render() {
  compute();
  $('locOut').textContent = fmtInt(S.loc) + ' LOC';
  $('langsOut').textContent = S.langs;
  $('dupOut').textContent = S.dup + ' %';
  $('covOut').textContent = S.cov + ' %';
  $('ifacesOut').textContent = S.ifaces;
  $('dbsOut').textContent = S.dbs;
  $('migHint').textContent = { upgrade: 'Gleiche Sprache, neue Framework- oder Laufzeitversion, z. B. Java 8 → 21, AngularJS → Angular.',
    platform: 'Gleiche Sprache, neue Plattform, z. B. Java EE auf WebLogic → Spring Boot in Containern.',
    language: 'Neue Sprache, z. B. VB6, Delphi, COBOL oder PHP → Java/Kotlin oder TypeScript.' }[S.mig];

  const res = $('result');
  res.classList.toggle('is-over', R.over);
  if (R.over) {
    $('price').innerHTML = '&gt; TCHF 150 <small>exkl. MWST</small>';
    $('priceSub').textContent = 'Etappierung in Module empfohlen';
  } else {
    const hi = Math.min(R.high, CFG.cap);
    $('price').innerHTML = `TCHF ${tchf(R.low)}–${tchf(hi)}`;
    $('priceSub').textContent = R.partOver ? 'exkl. MWST · Obergrenze TCHF 150 als Kostendach' : 'exkl. MWST · Fixpreis nach POC';
  }
  const l = Math.min(R.low, CFG.cap) / CFG.cap * 100, h = Math.min(R.high, CFG.cap) / CFG.cap * 100, m = Math.min(R.mid, CFG.cap) / CFG.cap * 100;
  $('capRange').style.left = l + '%'; $('capRange').style.width = Math.max(1, h - l) + '%';
  $('capMid').style.left = `calc(${m}% - 1px)`;

  const max = Math.max(...R.p);
  $('phases').innerHTML = R.p.map((v, i) =>
    `<li><span class="n">0${i + 1}</span><span>${PH[i]}</span><span class="v">${v ? 'TCHF ' + (v * S.rate / 1000).toFixed(1) : '–'}</span><span class="bar"><i style="width:${v / max * 100}%"></i></span></li>`
  ).join('') + `<li class="regie"><span class="n">06</span><span>Rückintegration, weitere Arbeiten</span><span class="v">nach Aufwand</span></li>`;

  const w1 = Math.max(3, Math.round(R.weeks * 0.9)), w2 = Math.max(w1 + 1, Math.round(R.weeks * 1.15));
  $('kDur').textContent = `${w1}–${w2} Wochen`;
  $('kEt').textContent = R.etappen;
  $('kMocks').textContent = R.mocks;
  $('kPt').textContent = '≈ ' + Math.round(R.pt);
  $('pEt').textContent = R.etappen;
  $('pMocks').textContent = R.mocks;
  renderSnap();
  if (current) showItem(current, true);
}

/* ---------- Inputs binden ---------- */
function bindRange(id, key) {
  const el = $(id); el.value = S[key];
  el.addEventListener('input', () => { S[key] = +el.value; render(); });
}
function syncLoc() { $('loc').value = S.loc; $('locRange').value = toSlider(S.loc); }
$('locRange').addEventListener('input', e => { S.loc = fromSlider(+e.target.value); $('loc').value = S.loc; render(); });
$('loc').addEventListener('change', e => { S.loc = Math.min(1e6, Math.max(1000, +e.target.value || 1000)); syncLoc(); render(); });
['langs', 'dup', 'cov', 'ifaces', 'dbs'].forEach(k => bindRange(k, k));
['knowledge', 'dataMig'].forEach(k => { $(k).checked = S[k]; $(k).addEventListener('change', e => { S[k] = e.target.checked; render(); }); });
['team'].forEach(k => { $(k).value = S[k]; $(k).addEventListener('change', e => { S[k] = Math.max(+e.target.min, Math.min(+e.target.max, +e.target.value || S[k])); e.target.value = S[k]; render(); }); });

document.querySelectorAll('.seg.rating').forEach(seg => {
  seg.innerHTML = RL.map((r, i) => `<button type="button" data-v="${i + 1}" aria-label="Rating ${r}">${r}</button>`).join('');
});
function syncSegs() {
  document.querySelectorAll('.seg[data-key]').forEach(seg => {
    const k = seg.dataset.key;
    seg.querySelectorAll('button').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.v == S[k])));
  });
}
document.querySelectorAll('.seg[data-key]').forEach(seg => seg.addEventListener('click', e => {
  const b = e.target.closest('button'); if (!b) return;
  const k = seg.dataset.key; S[k] = isNaN(+b.dataset.v) ? b.dataset.v : +b.dataset.v;
  syncSegs(); render();
}));
function syncAll() { syncLoc(); ['langs', 'dup', 'cov', 'ifaces', 'dbs'].forEach(k => $(k).value = S[k]); syncSegs(); }

/* ---------- SonarQube Import ---------- */
const SAMPLE = { component: { key: 'acme-billing', name: 'ACME Billing', measures: [
  { metric: 'ncloc', value: '84210' }, { metric: 'sqale_rating', value: '4.0' }, { metric: 'reliability_rating', value: '3.0' },
  { metric: 'security_rating', value: '2.0' }, { metric: 'coverage', value: '11.4' }, { metric: 'duplicated_lines_density', value: '14.2' },
  { metric: 'ncloc_language_distribution', value: 'java=61230;jsp=14980;sql=6100;js=1900' } ] } };
$('sonarSample').addEventListener('click', () => { $('sonarJson').value = JSON.stringify(SAMPLE, null, 2); });
$('sonarApply').addEventListener('click', () => {
  const msg = $('sonarMsg'); msg.className = 'msg';
  try {
    const j = JSON.parse($('sonarJson').value);
    const ms = (j.component && j.component.measures) || j.measures || [];
    const m = {}; ms.forEach(x => m[x.metric] = x.value ?? (x.period && x.period.value));
    const set = [];
    if (m.ncloc) { S.loc = Math.min(1e6, Math.max(1000, +m.ncloc)); set.push('LOC'); }
    [['sqale_rating', 'sqale'], ['reliability_rating', 'rel'], ['security_rating', 'sec']].forEach(([a, b]) => { if (m[a]) { S[b] = Math.min(5, Math.max(1, Math.round(+m[a]))); set.push(a.split('_')[0]); } });
    if (m.coverage != null) { S.cov = Math.min(90, Math.round(+m.coverage / 5) * 5); set.push('coverage'); }
    if (m.duplicated_lines_density != null) { S.dup = Math.min(40, Math.round(+m.duplicated_lines_density)); set.push('duplications'); }
    if (m.ncloc_language_distribution) { S.langs = Math.min(6, Math.max(1, m.ncloc_language_distribution.split(';').filter(Boolean).length)); set.push('Sprachen'); }
    if (!set.length) throw new Error('Keine bekannten Metriken gefunden');
    syncAll(); render();
    msg.classList.add('ok'); msg.textContent = '✓ Übernommen: ' + set.join(', ');
  } catch (err) { msg.classList.add('err'); msg.textContent = 'Konnte nicht gelesen werden: ' + err.message; }
});
document.querySelectorAll('[data-copy]').forEach(b => b.addEventListener('click', () => {
  navigator.clipboard?.writeText($(b.dataset.copy).textContent).then(() => { b.textContent = 'Kopiert'; setTimeout(() => b.textContent = 'Kopieren', 1400); });
}));

/* ---------- Lieferumfang ---------- */
const esc = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const ITEMS = [
  { id: 'docs', path: 'docs/', depth: 0, ph: ['01', '05'], pillar: 'doc', title: 'Dokumentation',
    desc: 'Alles, was man über die Applikation wissen muss, versioniert im selben Repository wie der Code.', code: () => null },
  { id: 'ctx', path: 'geschaeftskontext.md', depth: 1, ph: ['01'], pillar: 'doc', title: 'Geschäftskontext und fachliche Regeln',
    desc: 'Ergebnis von Schritt 01: welche Prozesse die Applikation trägt und welche Regeln sie abbildet. Jede Regel ist mit Code-Stellen und Tests verknüpft.',
    code: () => `<span class="c-k"># Fachliche Regeln</span>

| ID    | Regel                                    | Quelle            | Test |
|-------|------------------------------------------|-------------------|------|
| R-014 | Rabatt 5 % ab Bestellwert CHF 500        | RabattService:212 | <span class="c-g">✓</span>    |
| R-015 | Kein Rabatt auf Gutscheine               | RabattService:240 | <span class="c-g">✓</span>    |
| R-031 | Mahnung nach 30 Tagen, 2. Mahnung 14 T.  | MahnJob.pls       | <span class="c-g">✓</span>    |
| R-032 | Betreibung nur bei Betrag ≥ CHF 100      | <span class="c-c">nur Fachwissen</span>    | <span class="c-g">✓</span>    |` },
  { id: 'arc', path: 'architektur/', depth: 1, ph: ['05'], pillar: 'doc', title: 'Architekturdokumentation (arc42)',
    desc: 'Ausführliche Dokumentation der migrierten Applikation nach arc42, die Grundlage für Betrieb und Weiterentwicklung durch Ihr Team.',
    code: () => ['Einführung und Ziele', 'Randbedingungen', 'Kontextabgrenzung', 'Lösungsstrategie', 'Bausteinsicht', 'Laufzeitsicht', 'Verteilungssicht', 'Querschnittliche Konzepte', 'Architekturentscheidungen', 'Qualitätsanforderungen', 'Risiken und technische Schulden', 'Glossar']
      .map((t, i) => `<span class="c-g">✓</span> <span class="c-c">${String(i + 1).padStart(2, '0')}</span>  ${t}`).join('\n') },
  { id: 'adr', path: 'entscheide/', depth: 1, ph: ['04', '05'], pillar: 'doc', title: 'Architekturentscheide (ADR)',
    desc: 'Jeder wesentliche Entscheid während der Migration ist mit Kontext, Alternativen und Begründung festgehalten.',
    code: () => `<span class="c-k">ADR-007</span>  Session-State aus Applikationsserver in Redis auslagern
<span class="c-c">Status</span>   angenommen
<span class="c-c">Kontext</span>  Stateful EJBs verhindern horizontale Skalierung im Container.
<span class="c-c">Entscheid</span> Zustand extern halten, Services zustandslos.
<span class="c-c">Folgen</span>   + Skalierbar, + Rolling Deployments  − zusätzliche Komponente` },
  { id: 'report', path: 'migrationsprotokoll.md', depth: 1, ph: ['04'], pillar: 'doc', title: 'Migrationsprotokoll',
    desc: 'Der Fortschritt als Messwert: Nach jeder Etappe laufen Testset und Systemintegrationstests. Das Protokoll hält die Resultate fest.',
    etappen: true, code: () => null },
  { id: 'src', path: 'src/', depth: 0, ph: ['04'], pillar: 'code', title: 'Lauffähiger Quellcode',
    desc: 'Der migrierte Code auf zeitgemässer Basis, in Ihrem Repository, mit Build-Anleitung. Ihr Team kann ab dem ersten Tag damit arbeiten.',
    code: () => `<span class="c-c">$</span> git clone …/applikation.git && cd applikation
<span class="c-c">$</span> ./build.sh
<span class="c-g">BUILD SUCCESSFUL</span> in 48s
<span class="c-c">$</span> ./run-local.sh
<span class="c-g">Started Application</span> on port 8080 (profile: local, mocks: ${R.mocks})` },
  { id: 'readme', path: 'README.md', depth: 0, ph: ['05'], pillar: 'code', title: 'README',
    desc: 'Einstieg für Ihr Team: bauen, starten, testen, deployen, in wenigen Minuten nachvollziehbar.', code: () => `<span class="c-k">## Schnellstart</span>
1. Voraussetzungen: JDK 21, Docker
2. ./build.sh            <span class="c-c"># kompiliert und testet</span>
3. ./run-local.sh        <span class="c-c"># startet App inkl. Mocks</span>
4. ./test-all.sh         <span class="c-c"># Testset + Integrationstests</span>` },
  { id: 'tests', path: 'tests/', depth: 0, ph: ['02', '03'], pillar: 'test', title: 'Tests',
    desc: 'Das Sicherheitsnetz der Migration, und danach für jede künftige Änderung.', code: () => null },
  { id: 'char', path: 'verhalten/', depth: 1, ph: ['02'], pillar: 'test', title: 'Testset: heutiges Verhalten',
    desc: 'Ergebnis von Schritt 02: Tests, die das fachliche Verhalten der Altapplikation festhalten. Sie laufen gegen alt und neu, Abweichungen fallen sofort auf.',
    code: () => `<span class="c-k">@Test</span>
<span class="c-k">void</span> R014_rabatt_ab_500_wie_bisher() {
