];
let current = 'arc', phase = null, pillar = null;
function renderTree() {
  $('tree').innerHTML = `<li class="root">applikation/</li>` + ITEMS.map((it, i) => {
    const last = !ITEMS.slice(i + 1).some(n => n.depth <= it.depth) || (ITEMS[i + 1] && ITEMS[i + 1].depth < it.depth);
    const nextSameOrUp = ITEMS.slice(i + 1).find(n => n.depth <= it.depth);
    const isLast = !nextSameOrUp || nextSameOrUp.depth < it.depth;
    let ind = '';
    if (it.depth === 1) { const parentLast = !ITEMS.slice(i + 1).some(n => n.depth === 0); ind = (parentLast ? '   ' : '│  '); }
    ind += isLast ? '└─ ' : '├─ ';
    const dim = (phase && !it.ph.includes(phase)) || (pillar && it.pillar !== pillar);
    return `<li><button type="button" data-id="${it.id}" class="${it.id === current ? 'on' : ''} ${dim ? 'dim' : ''}"><span class="ind">${ind}</span><span>${it.path}</span><span class="ph">${it.ph.join('·')}</span></button></li>`;
  }).join('');
}
function showItem(id, silent) {
  current = id; const it = ITEMS.find(x => x.id === id);
  const desc = typeof it.desc === 'function' ? it.desc() : it.desc;
  const pill = { doc: 'Architekturdokumentation', code: 'Lauffähiger Code', test: 'Tests' }[it.pillar];
  let body = '';
  const c = it.code();
  if (c) body = `<div class="code-block"><pre>${c}</pre></div>`;
  if (it.etappen) {
    body = `<div class="etappen">` + Array.from({ length: R.etappen }, (_, i) => {
      const doneE = true;
      return `<div class="et ${doneE ? '' : 'open'}"><span>Etappe ${i + 1}</span><span class="tr"><i style="width:${doneE ? 100 : 60}%"></i></span><span>${doneE ? '<span style="color:#1a7f37">✓ grün</span>' : 'läuft …'}</span></div>`;
    }).join('') + `</div>`;
  }
  if (!c && !it.etappen) {
    const kids = ITEMS.filter((x, i) => i > ITEMS.indexOf(it) && x.depth === 1 && ITEMS.slice(ITEMS.indexOf(it) + 1, i).every(y => y.depth === 1));
    body = `<div class="etappen">` + kids.map(k => `<button type="button" class="btn ghost" data-go="${k.id}" style="justify-content:space-between">${k.path}<span class="label">${k.title}</span></button>`).join('') + `</div>`;
  }
  $('preview').innerHTML = `<p class="label brand">${it.path}</p><h3>${it.title}</h3><p class="desc">${desc}</p>
    <div class="meta"><span class="chip b">${pill}</span>${it.ph.map(p => `<span class="chip">Schritt ${p}</span>`).join('')}</div>${body}
    <p class="note">Illustratives Beispiel. Inhalte entstehen aus Ihrer Applikation.</p>`;
  if (!silent) renderTree(); else renderTree();
}
$('tree').addEventListener('click', e => { const b = e.target.closest('button[data-id]'); if (!b) return;
  if (b.classList.contains('dim')) { phase = null; pillar = null; document.querySelectorAll('.timeline button').forEach(x => x.setAttribute('aria-pressed', 'false')); document.querySelectorAll('.pillar').forEach(x => x.classList.remove('on')); }
  showItem(b.dataset.id); });
$('preview').addEventListener('click', e => { const b = e.target.closest('[data-go]'); if (b) showItem(b.dataset.go); });
document.querySelectorAll('.timeline button').forEach(b => b.addEventListener('click', () => {
  phase = phase === b.dataset.ph ? null : b.dataset.ph; pillar = null;
  document.querySelectorAll('.pillar').forEach(p => p.classList.remove('on'));
  document.querySelectorAll('.timeline button').forEach(x => x.setAttribute('aria-pressed', String(x.dataset.ph === phase)));
  if (phase) { const first = ITEMS.find(it => it.ph.includes(phase) && it.code()); if (first) current = first.id; }
  showItem(current);
}));
document.querySelectorAll('.pillar').forEach(p => {
  const act = () => {
    pillar = pillar === p.dataset.pillar ? null : p.dataset.pillar; phase = null;
    document.querySelectorAll('.timeline button').forEach(x => x.setAttribute('aria-pressed', 'false'));
    document.querySelectorAll('.pillar').forEach(x => x.classList.toggle('on', x.dataset.pillar === pillar));
    if (pillar) { const first = ITEMS.find(it => it.pillar === pillar && it.depth === (pillar === 'code' ? 0 : 1)); if (first) current = first.id; }
    showItem(current);
  };
  p.addEventListener('click', act); p.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); act(); } });
});

/* ---------- POC ---------- */
let src = 'repo', zipFile = null;
const loadedAt = Date.now();
document.querySelectorAll('.tabs button').forEach(b => b.addEventListener('click', () => {
  src = b.dataset.src;
  document.querySelectorAll('.tabs button').forEach(x => x.setAttribute('aria-selected', String(x === b)));
  $('srcRepo').hidden = src !== 'repo'; $('srcZip').hidden = src !== 'zip';
}));
const drop = $('drop');
function setZip(f) {
  const msg = $('formMsg'); msg.textContent = ''; msg.className = 'msg';
  if (!f) return;
  if (!/\.zip$/i.test(f.name)) { msg.classList.add('err'); msg.textContent = 'Bitte eine ZIP-Datei wählen.'; return; }
  if (f.size > CFG.maxZipMB * 1048576) { msg.classList.add('err'); msg.textContent = `Datei ist grösser als ${CFG.maxZipMB} MB. Bitte Repository-Link verwenden.`; return; }
  zipFile = f; drop.classList.add('has');
  $('dropTitle').textContent = '📦 ' + f.name;
  $('dropSub').textContent = (f.size / 1048576).toFixed(1) + ' MB · andere Datei wählen';
}
$('fZip').addEventListener('change', e => setZip(e.target.files[0]));
['dragenter', 'dragover'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.add('drag'); }));
['dragleave', 'drop'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.remove('drag'); }));
drop.addEventListener('drop', e => setZip(e.dataTransfer.files[0]));

const lbl = { ui: { none: 'keine', web: 'Web-UI', rich: 'Rich Client' }, mig: { upgrade: 'Framework-Upgrade', platform: 'Plattformwechsel', language: 'Sprachwechsel' }, docs: { good: 'aktuell', partial: 'teilweise', none: 'fehlt' } };
function calcLines() {
  const price = R.over ? '> TCHF 150 (Etappierung)' : `TCHF ${tchf(R.low)}–${tchf(Math.min(R.high, CFG.cap))} exkl. MWST`;
  return [
    `Lines of Code: ${fmtInt(S.loc)} · Sprachen: ${S.langs} · UI: ${lbl.ui[S.ui]}`,
    `Migration: ${lbl.mig[S.mig]}`,
    `SonarQube: Maintainability ${RL[S.sqale - 1]} · Reliability ${RL[S.rel - 1]} · Security ${RL[S.sec - 1]} · Coverage ${S.cov} % · Duplikate ${S.dup} %`,
    `Umsysteme: ${S.ifaces} · Datenhaltungen: ${S.dbs} · Doku: ${lbl.docs[S.docs]} · Datenmigration: ${S.dataMig ? 'ja' : 'nein'}`,
    `Richtpreis Rechner: ${price}`,
  ];
}
function renderSnap() {
  const on = $('fCalc').checked; $('snap').hidden = !on;
  if (on) $('snap').innerHTML = calcLines().map(l => { const i = l.indexOf(':'); return `${esc(l.slice(0, i + 1))} <b>${esc(l.slice(i + 1).trim())}</b>`; }).join('<br>');
}
$('fCalc').addEventListener('change', renderSnap);

function buildMail(f) {
  const lines = [
    'Guten Tag', '', 'Wir interessieren uns für einen POC zur Migration unserer Applikation.', '',
    `Firma: ${f.company}`, `Name: ${f.name}`, `E-Mail: ${f.email}`, f.phone ? `Telefon: ${f.phone}` : null, '',
    'Applikation und Ziel:', f.app, '',
    src === 'repo' ? `Quellcode (Repository): ${f.repo}` : `Quellcode: ZIP-Datei «${zipFile.name}» (${(zipFile.size / 1048576).toFixed(1)} MB), siehe Anhang`,
    f.nda ? 'Wir wünschen vorgängig eine Vertraulichkeitsvereinbarung (NDA).' : null,
  ].filter(x => x !== null);
  if ($('fCalc').checked) lines.push('', '— Angaben aus dem Preisrechner —', ...calcLines());
  lines.push('', 'Freundliche Grüsse', f.name);
  return lines.join('\n');
}
$('pocForm').addEventListener('submit', async e => {
  e.preventDefault();
  const msg = $('formMsg'); msg.className = 'msg'; msg.textContent = '';
  const f = { company: $('fCompany').value.trim(), name: $('fName').value.trim(), email: $('fEmail').value.trim(), phone: $('fPhone').value.trim(),
    app: $('fApp').value.trim(), repo: $('fRepo').value.trim(), nda: $('fNda').checked };
  const errs = [];
  if (!f.company) errs.push('Firma'); if (!f.name) errs.push('Name');
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(f.email)) errs.push('gültige E-Mail');
  if (!f.app) errs.push('Beschreibung der Applikation');
  if (src === 'repo' && !/^https?:\/\/\S+\.\S+/.test(f.repo)) errs.push('Repository-Link (https://…)');
  if (src === 'zip' && !zipFile) errs.push('ZIP-Datei');
  if (errs.length) { msg.classList.add('err'); msg.textContent = 'Bitte ergänzen: ' + errs.join(', '); return; }

  const body = buildMail(f);
  const fd = new FormData(); Object.entries(f).forEach(([k, v]) => fd.append(k, v));
  fd.append('summary', body); fd.append('src', src);
  fd.append('website', $('fWebsite').value); fd.append('t', String(Date.now() - loadedAt));
  if (zipFile && src === 'zip') fd.append('source', zipFile);
  const btn = e.submitter; if (btn) btn.disabled = true;
  try {
    const r = await fetch(CFG.endpoint, { method: 'POST', body: fd });
    const j = await r.json().catch(() => ({}));
    if (!r.ok || !j.ok) throw new Error(j.message || 'HTTP ' + r.status);
    showDone();
  } catch (err) {
    msg.classList.add('err');
    msg.textContent = `Senden fehlgeschlagen (${err.message}). Bitte später erneut versuchen oder direkt an hello@plaintext.ch schreiben.`;
  } finally { if (btn) btn.disabled = false; }
});
function showDone() {
  $('pocFields').hidden = true; $('done').classList.add('show');
  $('doneTxt').textContent = src === 'zip' ? 'Ihre Anfrage und der Quellcode sind bei uns eingegangen. Wir melden uns innerhalb von zwei Arbeitstagen.'
    : 'Wir melden uns innerhalb von zwei Arbeitstagen.';
}
$('back').addEventListener('click', () => { $('pocFields').hidden = false; $('done').classList.remove('show'); });

/* ---------- Init ---------- */
syncAll(); render(); renderTree(); showItem('arc');
})();
</script>
