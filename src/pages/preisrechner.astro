    var rechnung = service.fakturiere(bestellung);

    assertThat(rechnung.total()).isEqualTo(<span class="c-s">"494.00"</span>);   <span class="c-c">// festgehalten aus Legacy</span>
}` },
  { id: 'sit', path: 'integration/', depth: 1, ph: ['03', '04'], pillar: 'test', title: 'Systemintegrationstests',
    desc: 'Laufen gegen die gemockten Umsysteme. Nach jeder Etappe ein klares Ergebnis: grün oder nicht.',
    code: () => `<span class="c-c">$</span> ./test-all.sh
Testset (Verhalten) ............ <span class="c-g">grün</span>
Integration gegen ${R.mocks} Mock(s) ...... <span class="c-g">grün</span>
Etappe ${R.etappen}/${R.etappen} abgeschlossen` },
  { id: 'mocks', path: 'mocks/', depth: 0, ph: ['03'], pillar: 'test', title: 'Mocks der Umsysteme',
    desc: () => `Ergebnis von Schritt 03: ${R.mocks ? R.mocks + ' Umsystem' + (R.mocks > 1 ? 'e' : '') + ' als Mock nachgebildet' : 'Keine Umsysteme angegeben'}. So lässt sich die Applikation isoliert starten und testen, ohne Zugriff auf Ihre produktiven Systeme.`,
    code: () => `<span class="c-c">// mocks/partnerregister/kunde-4711.json</span>
