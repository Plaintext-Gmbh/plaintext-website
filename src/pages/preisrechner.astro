---
// Karte 2434: Preisrechner Legacy-Migration, übernommen aus Daniels Entwurf
// (Nextcloud /Projekte/plaintext/website/26-11-21_preisrechner-entwurf.html).
// Eigenes CSS unter .pr, weil Teile der Vorschau per JavaScript entstehen (Astro-Scoping greift dort nicht).
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/strings';

const lang = 'de' as const;
const meta = t(lang).calculator.meta;
const endpoint = `${import.meta.env.BASE_URL}api/poc.php`;
---

<Layout lang={lang} page="calculator" title={meta.title} description={meta.description}>
  <Nav lang={lang} page="calculator" />
  <main class="pr">
<header class="hero tone-dark" id="top">
  <div class="wrap">
    <p class="label">Produkt · Legacy-Migration · Preisrechner</p>
    <h1 class="display">Was kostet die Migration Ihrer Applikation?</h1>
    <p class="lead">Geben Sie ein paar Kennzahlen ein, Lines of Code, SonarQube-Ratings, Umsysteme, und Sie erhalten in einer Minute einen Richtpreis. Fix, bis maximal TCHF 150 exkl. MWST, aufgeteilt auf die fünf Schritte unseres Vorgehens.</p>
    <div class="cta"><a class="btn light lg" href="#rechner">Preis berechnen</a><a class="btn lg" style="box-shadow:inset 0 0 0 1px #ffffff4d" href="#poc">Direkt POC anfragen</a></div>
    <div class="facts">
      <div><b>≤ TCHF 150</b><span>Fixpreis exkl. MWST</span></div>
      <div><b>5 Schritte</b><span>jeder mit prüfbarem Ergebnis</span></div>
      <div><b>3 Artefakte</b><span>Doku · Code · Tests</span></div>
    </div>
  </div>
</header>

<!-- ============ RECHNER ============ -->
<section id="rechner">
  <div class="wrap">
    <header class="sec-head">
      <p class="label brand">Preisrechner</p>
      <h2 class="display">Vom Codeumfang zum Richtpreis</h2>
      <p>Die Schätzung basiert auf Grösse und Zustand des Codes sowie dem Umfeld der Applikation. Je genauer die Angaben, desto enger das Preisband.</p>
    </header>

    <div class="calc">
      <div>
        <!-- 01 Umfang -->
        <div class="panel group">
          <h3><span class="label brand">01</span>Umfang der Applikation</h3>
          <p class="muted">Lines of Code ohne Leerzeilen und Kommentare (in SonarQube: «Lines of Code», bei cloc: «code»).</p>
          <div class="fields">
            <div class="field">
              <label class="l" for="locRange">Lines of Code <span class="val" id="locOut"></span></label>
              <div class="row">
                <input type="range" id="locRange" min="0" max="1000" step="1" aria-label="Lines of Code (Regler)">
                <input type="number" id="loc" min="1000" max="1000000" step="1000" aria-label="Lines of Code">
              </div>
            </div>
          </div>
          <div class="fields two">
            <div class="field">
              <label class="l" for="langs">Sprachen / Technologien im Bestand <span class="val" id="langsOut"></span></label>
              <input type="range" id="langs" min="1" max="6" step="1">
              <p class="hint">z. B. Java + JSP + PL/SQL = 3</p>
            </div>
            <div class="field">
              <label class="l">Benutzeroberfläche</label>
              <div class="seg" data-key="ui">
                <button type="button" data-v="none">Keine (Backend/Batch)</button>
                <button type="button" data-v="web">Web-UI</button>
                <button type="button" data-v="rich">Rich Client</button>
              </div>
            </div>
          </div>
          <div class="fields">
            <div class="field">
              <label class="l">Art der Migration</label>
              <div class="seg" data-key="mig">
                <button type="button" data-v="upgrade">Framework-Upgrade</button>
                <button type="button" data-v="platform">Plattformwechsel</button>
                <button type="button" data-v="language">Sprachwechsel</button>
              </div>
              <p class="hint" id="migHint"></p>
            </div>
          </div>
        </div>

        <!-- 02 Sonar -->
        <div class="panel group">
          <h3><span class="label brand">02</span>Codequalität (SonarQube)</h3>
          <p class="muted">Ratings aus dem SonarQube-Dashboard. Ohne Analyse lassen Sie die Standardwerte stehen.</p>
          <div class="fields two">
            <div class="field">
              <label class="l">Maintainability</label>
              <div class="seg rating" data-key="sqale"></div>
              <p class="hint">Technical-Debt-Ratio: A ≤ 5 % … E &gt; 50 %</p>
            </div>
            <div class="field">
              <label class="l">Reliability</label>
              <div class="seg rating" data-key="rel"></div>
            </div>
            <div class="field">
              <label class="l">Security</label>
              <div class="seg rating" data-key="sec"></div>
            </div>
            <div class="field">
              <label class="l" for="dup">Duplizierte Zeilen <span class="val" id="dupOut"></span></label>
              <input type="range" id="dup" min="0" max="40" step="1">
            </div>
            <div class="field">
              <label class="l" for="cov">Testabdeckung heute <span class="val" id="covOut"></span></label>
              <input type="range" id="cov" min="0" max="90" step="5">
              <p class="hint">Bestehende Tests verkürzen den Aufbau des Testsets.</p>
            </div>
          </div>

          <details class="box" id="sonarBox">
            <summary>SonarQube-Messwerte importieren</summary>
            <div class="in">
              <p class="hint" style="margin-bottom:.75rem">Rufen Sie die Web-API Ihrer SonarQube-Instanz auf und fügen Sie die JSON-Antwort ein. Die Daten bleiben im Browser.</p>
              <div class="code-block"><code id="sonarUrl">GET /api/measures/component?component=&lt;PROJECT_KEY&gt;&amp;metricKeys=ncloc,sqale_rating,reliability_rating,security_rating,coverage,duplicated_lines_density,ncloc_language_distribution</code><button class="copy-btn" type="button" data-copy="sonarUrl">Kopieren</button></div>
              <textarea id="sonarJson" style="margin-top:.75rem;font-family:var(--mono);font-size:.78rem" placeholder='{"component":{"measures":[{"metric":"ncloc","value":"84210"}, …]}}'></textarea>
              <div class="row" style="margin-top:.6rem;flex-wrap:wrap">
                <button class="btn" type="button" id="sonarApply">Übernehmen</button>
                <button class="btn ghost" type="button" id="sonarSample">Beispiel laden</button>
              </div>
              <p class="msg" id="sonarMsg" role="status"></p>
            </div>
          </details>
        </div>

        <!-- 03 Umfeld -->
        <div class="panel group">
          <h3><span class="label brand">03</span>Umfeld und Wissen</h3>
          <p class="muted">Umsysteme werden als Mocks nachgebildet, damit jede Etappe per Systemintegrationstest messbar wird.</p>
          <div class="fields two">
            <div class="field">
              <label class="l" for="ifaces">Schnittstellen zu Umsystemen <span class="val" id="ifacesOut"></span></label>
              <input type="range" id="ifaces" min="0" max="20" step="1">
              <p class="hint">REST, SOAP, Messaging, Datei-Austausch, DB-Links …</p>
            </div>
            <div class="field">
              <label class="l" for="dbs">Datenbanken / Datenhaltungen <span class="val" id="dbsOut"></span></label>
              <input type="range" id="dbs" min="0" max="6" step="1">
            </div>
            <div class="field">
              <label class="l">Dokumentation heute</label>
              <div class="seg" data-key="docs">
                <button type="button" data-v="good">Aktuell</button>
                <button type="button" data-v="partial">Teilweise</button>
                <button type="button" data-v="none">Fehlt</button>
              </div>
            </div>
            <div class="field" style="display:grid;gap:.7rem;align-content:start">
              <label class="check"><input type="checkbox" id="knowledge"> Fachliche Ansprechperson steht für Fragen zur Verfügung</label>
              <label class="check"><input type="checkbox" id="dataMig"> Datenmodell ändert sich (Datenmigration nötig)</label>
            </div>
          </div>

          <details class="box">
            <summary>Annahmen des Rechners</summary>
            <div class="in">
              <div class="fields two" style="margin-top:0">
                <div class="field">
                  <label class="l" for="team">Teamgrösse (Personen)</label>
                  <input type="number" id="team" min="1" max="5" step="1">
                </div>
              </div>
              <p class="hint" style="margin-top:1rem">Modell: Kernaufwand = 3.0 × KLOC<sup>0.6</sup> (bereinigt um Duplikate) × Qualitäts- und Technologiefaktoren; anschliessend Verteilung auf die Schritte 01–05. Schritt 06 wird nach Aufwand verrechnet und ist nicht enthalten.</p>
            </div>
          </details>
        </div>
      </div>

      <!-- RESULT -->
      <aside class="result" id="result" aria-live="polite">
        <p class="label">Richtpreis Schritte 01–05</p>
        <div class="price" id="price">–</div>
        <p class="sub" id="priceSub">exkl. MWST · Fixpreis nach POC</p>
        <div class="cap" aria-hidden="true"><i class="range" id="capRange"></i><i id="capMid" style="width:2px"></i></div>
        <div class="capl"><span>0</span><span>TCHF 75</span><span>TCHF 150</span></div>
        <div class="over" id="over">Über dem Rahmen von TCHF 150. Wir empfehlen, die Applikation in fachlich abgegrenzte Module aufzuteilen und diese einzeln zu migrieren. Der POC zeigt, wo sich schneiden lässt.</div>
        <ul class="phases" id="phases"></ul>
        <div class="kpis">
          <div><b id="kDur">–</b><span>Dauer</span></div>
          <div><b id="kEt">–</b><span>Migrationsetappen</span></div>
          <div><b id="kMocks">–</b><span>Mocks Umsysteme</span></div>
          <div><b id="kPt">–</b><span>Personentage</span></div>
        </div>
        <a class="btn light lg" href="#poc" id="toPoc">POC mit diesen Angaben anfragen</a>
        <p class="fine">Indikative Schätzung, kein Angebot. Der verbindliche Fixpreis folgt nach einem kostenlosen POC auf Basis Ihres Quellcodes.</p>
      </aside>
    </div>
  </div>
</section>

<!-- ============ LIEFERUMFANG ============ -->
<section id="lieferumfang" class="tone-grey">
  <div class="wrap">
    <header class="sec-head">
      <p class="label brand">Lieferumfang</p>
      <h2 class="display">Das bekommen Sie, Datei für Datei</h2>
      <p>Am Ende übergeben wir ein Repository, das Ihr Team übernehmen kann. Klicken Sie sich durch: Welche Artefakte entstehen, in welchem Schritt, und wie sie aussehen.</p>
    </header>

    <div class="pillars">
      <div class="panel pillar" data-pillar="doc" tabindex="0" role="button">
        <span class="label brand">Artefakt 1</span>
        <h3>Architekturdokumentation</h3>
        <p>arc42-strukturiert, inkl. Geschäftskontext, fachlicher Regeln und Entscheide. Grundlage für Betrieb und Weiterentwicklung.</p>
        <p class="k">12 Kapitel · <b>Geschäftsregeln</b> · ADRs</p>
      </div>
      <div class="panel pillar" data-pillar="code" tabindex="0" role="button">
        <span class="label brand">Artefakt 2</span>
        <h3>Lauffähiger Code</h3>
        <p>Der migrierte Quellcode, lokal startbar und bereit zur Übernahme durch Ihr Team.</p>
        <p class="k">in <b id="pEt">–</b> Etappen nachgewiesen</p>
      </div>
      <div class="panel pillar" data-pillar="test" tabindex="0" role="button">
        <span class="label brand">Artefakt 3</span>
        <h3>Tests</h3>
        <p>Testset, das das fachliche Verhalten belegt, plus Systemintegrationstests gegen gemockte Umsysteme.</p>
        <p class="k"><b id="pMocks">–</b> Mocks · jederzeit ausführbar</p>
      </div>
    </div>

    <div class="timeline" role="group" aria-label="Nach Schritt filtern">
      <button type="button" data-ph="01" aria-pressed="false"><span class="label">01</span><b>Analyse</b></button>
      <button type="button" data-ph="02" aria-pressed="false"><span class="label">02</span><b>Testset</b></button>
      <button type="button" data-ph="03" aria-pressed="false"><span class="label">03</span><b>Mocks</b></button>
      <button type="button" data-ph="04" aria-pressed="false"><span class="label">04</span><b>Migration</b></button>
      <button type="button" data-ph="05" aria-pressed="false"><span class="label">05</span><b>Übergabe</b></button>
    </div>

    <div class="deliv">
      <ul class="panel tree" id="tree" aria-label="Repository-Struktur"></ul>
      <div class="panel preview" id="preview" aria-live="polite"></div>
    </div>
  </div>
</section>

<!-- ============ POC ============ -->
<section id="poc">
  <div class="wrap">
    <header class="sec-head">
      <p class="label brand">Proof of Concept</p>
      <h2 class="display">Schicken Sie uns den Code. Wir zeigen, wie es geht.</h2>
      <p>Für den POC analysieren wir einen Ausschnitt Ihrer Applikation, erstellen erste Tests und migrieren ein Modul. Danach kennen Sie den Fixpreis.</p>
    </header>

    <div class="poc">
      <aside class="panel">
        <p class="label brand">So läuft der POC</p>
        <ol>
          <li><span class="label brand">01</span><span>Sie laden den Code hoch oder teilen einen Repository-Link.</span></li>
          <li><span class="label brand">02</span><span>Wir melden uns innerhalb von zwei Arbeitstagen, auf Wunsch mit NDA.</span></li>
          <li><span class="label brand">03</span><span>Analyse, erstes Testset und Migration eines Moduls.</span></li>
          <li><span class="label brand">04</span><span>Ergebnisbesprechung und verbindlicher Fixpreis.</span></li>
        </ol>
      </aside>

      <form class="panel" id="pocForm" action={endpoint} method="post" enctype="multipart/form-data" novalidate>
        <!-- Honeypot: für Menschen unsichtbar, Bots füllen es aus. -->
        <div class="sr" aria-hidden="true"><label for="fWebsite">Website</label><input type="text" id="fWebsite" name="website" tabindex="-1" autocomplete="off"></div>
        <div id="pocFields">
          <div class="fields two" style="margin-top:0">
            <div class="field"><label class="l" for="fCompany">Firma <span class="req">*</span></label><input type="text" id="fCompany" name="company" required autocomplete="organization"></div>
            <div class="field"><label class="l" for="fName">Name <span class="req">*</span></label><input type="text" id="fName" name="name" required autocomplete="name"></div>
            <div class="field"><label class="l" for="fEmail">E-Mail <span class="req">*</span></label><input type="email" id="fEmail" name="email" required autocomplete="email"></div>
            <div class="field"><label class="l" for="fPhone">Telefon</label><input type="tel" id="fPhone" name="phone" autocomplete="tel"></div>
          </div>
          <div class="fields">
            <div class="field"><label class="l" for="fApp">Applikation und Ziel <span class="req">*</span></label><textarea id="fApp" name="app" required placeholder="Was macht die Applikation, welcher Stack heute, wohin soll es gehen? z. B. «Java EE 6 auf WebLogic → Spring Boot 3 in Containern»"></textarea></div>

            <div class="field">
              <span class="l" style="display:block;font-size:.9rem;font-weight:500;margin-bottom:.5rem">Quellcode <span class="req">*</span></span>
              <div class="tabs" role="tablist">
                <button type="button" role="tab" aria-selected="true" data-src="repo">Repository-Link</button>
                <button type="button" role="tab" aria-selected="false" data-src="zip">ZIP hochladen</button>
              </div>
              <div id="srcRepo" style="margin-top:1rem">
                <input type="url" id="fRepo" name="repo" placeholder="https://github.com/organisation/applikation">
                <p class="hint">Öffentliches Repository oder Link mit Lesezugriff (GitHub, GitLab, Bitbucket, Azure DevOps).</p>
              </div>
              <div id="srcZip" hidden>
                <label class="drop" id="drop">
                  <input type="file" id="fZip" name="source" accept=".zip,application/zip" class="sr">
                  <b id="dropTitle">ZIP-Datei hierher ziehen oder auswählen</b>
                  <span class="label" id="dropSub">max. 20 MB · ohne Binaries, Secrets und Kundendaten</span>
                </label>
              </div>
            </div>

            <label class="check"><input type="checkbox" id="fNda" name="nda"> Wir wünschen vorgängig eine Vertraulichkeitsvereinbarung (NDA)</label>
            <label class="check"><input type="checkbox" id="fCalc" name="calc" checked> Angaben aus dem Preisrechner mitsenden</label>
            <div class="snap" id="snap"></div>
          </div>
          <div class="row" style="margin-top:1.5rem;flex-wrap:wrap">
            <button class="btn lg" type="submit">POC anfragen</button>
            <span class="hint" style="font-size:.8rem;color:var(--ink-500)">Wird direkt an hello@plaintext.ch übermittelt</span>
          </div>
          <p class="msg" id="formMsg" role="alert"></p>
        </div>
        <div class="done" id="done">
          <p class="label brand">Vielen Dank</p>
          <h3 class="display" style="font-size:1.6rem;margin-top:.6rem">Ihre Anfrage ist eingegangen.</h3>
          <p class="muted" id="doneTxt" style="margin-top:.8rem;max-width:32rem;margin-inline:auto;line-height:1.6"></p>
          <div class="row" style="justify-content:center;margin-top:1.4rem;flex-wrap:wrap">
            <button class="btn ghost" type="button" id="back">Zurück zum Formular</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>
  </main>
  <Footer lang={lang} />
</Layout>

<style is:global>
.pr{
    --ink-0:#fff; --ink-50:#f7f7fa; --ink-100:#ececf3; --ink-200:#dcdde8; --ink-300:#b6b7c4;
    --ink-500:#6b6c80; --ink-700:#2a2b3a; --ink-900:#0a0a14; --brand:#2d2bfe; --brand-soft:#2d2bfe14;
    --sans:Inter,system-ui,-apple-system,sans-serif; --mono:"JetBrains Mono",ui-monospace,SFMono-Regular,monospace;
  }
  .pr .label{font-family:var(--mono);letter-spacing:.04em;color:var(--ink-500);font-size:.8125rem;line-height:1.6}
  .pr .brand{color:var(--brand)}
  .pr .display{letter-spacing:-.025em;font-weight:600;line-height:1.15;text-wrap:balance}
  .pr .muted{color:var(--ink-500)}
  .pr .panel{background:var(--ink-50);border-radius:1rem;padding:1.5rem}
  @media(min-width:768px){.pr .panel{padding:2rem}}
  .pr .tone-grey{background:var(--ink-50)}
  .pr .tone-grey .panel{background:#fff}
  .pr .tone-dark{background:var(--ink-700);color:#fff}
  .pr .tone-dark .label{color:#ffffffa6}
  .pr .btn{display:inline-flex;align-items:center;gap:.5rem;white-space:nowrap;background:var(--ink-700);color:#fff;border:0;border-radius:.5rem;padding:.5rem .9rem;font-size:.875rem;font-weight:500;line-height:1.25;cursor:pointer;transition:background .15s}
  .pr .btn:hover{background:var(--brand)}
  .pr .btn.lg{padding:.75rem 1.2rem;font-size:.95rem}
  .pr .btn.ghost{background:transparent;color:var(--ink-700);box-shadow:inset 0 0 0 1px var(--ink-200)}
  .pr .btn.ghost:hover{background:var(--ink-50);color:var(--brand)}
  .pr .btn.light{background:#fff;color:var(--ink-900)}
  .pr .btn.light:hover{background:var(--brand);color:#fff}
  .pr .link-arrow{color:var(--brand);font-weight:500;text-decoration:underline 1px;text-underline-offset:.3em}
  .pr section{padding:4.5rem 0}
  @media(min-width:768px){.pr section{padding:6rem 0}}
  .pr .sec-head{max-width:42rem;margin:0 auto 2.5rem;text-align:center}
  .pr .sec-head h2{font-size:2rem;margin-top:.75rem}
  @media(min-width:768px){.pr .sec-head h2{font-size:2.25rem}}
  .pr .sec-head p{margin-top:1rem;font-size:1.125rem;color:var(--ink-500);line-height:1.65}
  .pr .hero{padding:8rem 0 4rem;text-align:center}
  @media(min-width:768px){.pr .hero{padding:11rem 0 6rem}}
  .pr .hero h1{font-size:2.4rem;margin-top:1.25rem;letter-spacing:-.025em}
  @media(min-width:768px){.pr .hero h1{font-size:3.75rem}}
  .pr .hero p.lead{margin:1.75rem auto 0;max-width:42rem;font-size:1.15rem;color:#ffffffd1;line-height:1.65}
  .pr .hero .cta{margin-top:2.25rem;display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap}
  .pr .facts{margin:3rem auto 0;max-width:46rem;display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;text-align:left}
  .pr .facts div{border-top:1px solid #ffffff38;padding-top:.8rem}
  .pr .facts b{display:block;font-size:1.35rem;font-weight:600;letter-spacing:-.02em}
  .pr .facts span{font-family:var(--mono);font-size:.75rem;color:#ffffffa6}
  .pr .calc{display:grid;gap:1.5rem;align-items:start}
  @media(min-width:960px){.pr .calc{grid-template-columns:minmax(0,1fr) 22rem}}
  .pr .group{margin-bottom:1.25rem}
  .pr .group h3{font-size:1.2rem;font-weight:600;letter-spacing:-.02em;display:flex;gap:.9rem;align-items:baseline}
  .pr .group > p.muted{margin-top:.35rem;font-size:.95rem}
  .pr .fields{display:grid;gap:1.25rem 1.5rem;margin-top:1.5rem}
  @media(min-width:640px){.pr .fields.two{grid-template-columns:1fr 1fr}}
  .pr .field label.l{display:flex;justify-content:space-between;gap:1rem;font-size:.9rem;font-weight:500;margin-bottom:.5rem}
  .pr .field label.l .val{font-family:var(--mono);font-weight:400;color:var(--brand);font-size:.85rem}
  .pr .field .hint{font-size:.8rem;color:var(--ink-500);margin-top:.4rem;line-height:1.5}
  .pr input[type=number],.pr input[type=text],.pr input[type=email],.pr input[type=url],.pr input[type=tel],.pr select,.pr textarea{width:100%;background:#fff;border:1px solid var(--ink-200);border-radius:.5rem;padding:.6rem .75rem;font-size:.95rem;outline:none;transition:border .15s,box-shadow .15s}
  .pr .tone-grey input,.pr .tone-grey select,.pr .tone-grey textarea{background:#fff}
  .pr input:focus,.pr select:focus,.pr textarea:focus{border-color:var(--brand);box-shadow:0 0 0 3px var(--brand-soft)}
  .pr textarea{resize:vertical;min-height:6rem}
  .pr input[type=range]{width:100%;accent-color:var(--brand);height:1.4rem}
  .pr .row{display:flex;gap:.75rem;align-items:center}
  .pr .row input[type=number]{max-width:9rem;font-family:var(--mono);font-size:.875rem}
  .pr .seg{display:flex;flex-wrap:wrap;gap:.4rem}
  .pr .seg button{border:1px solid var(--ink-200);background:#fff;border-radius:.5rem;padding:.45rem .8rem;font-size:.85rem;cursor:pointer;transition:all .15s}
  .pr .seg button:hover{border-color:var(--ink-500)}
  .pr .seg button[aria-pressed=true]{background:var(--ink-700);border-color:var(--ink-700);color:#fff}
  .pr .seg.rating button{font-family:var(--mono);width:2.4rem;padding:.45rem 0;text-align:center}
